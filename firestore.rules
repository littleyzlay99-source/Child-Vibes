rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny Catch-All First)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Deterministic Level 1-999 Curve Helpers (Mirrors progressionService.ts bit-for-bit)
    // Lv 1-100: 150 XP/level (15,000 XP span); Lv 101-999: 300 XP/level (284,400 XP total to Lv 999)
    function computeLevelRule(totalXp) {
      return int(totalXp) >= 284400
        ? 999
        : (int(totalXp) < 15000
          ? 1 + (int(totalXp) / 150)
          : 101 + ((int(totalXp) - 15000) / 300));
    }

    function computeCurrentLevelXpRule(totalXp) {
      return int(totalXp) >= 284400
        ? (int(totalXp) - 284400)
        : (int(totalXp) < 15000
          ? (int(totalXp) % 150)
          : ((int(totalXp) - 15000) % 300));
    }

    function computeLegacyTotalXpRule(lvl, xpVal) {
      let clampedLvl = int(lvl) < 1 ? 1 : (int(lvl) > 999 ? 999 : int(lvl));
      let safeXp = int(xpVal) < 0 ? 0 : int(xpVal);
      let base = clampedLvl <= 1
        ? 0
        : (clampedLvl <= 101
          ? (clampedLvl - 1) * 150
          : 15000 + (clampedLvl - 101) * 300);
      return base + safeXp;
    }

    function existingTotalXpRule(data) {
      return ('totalXp' in data && data.totalXp is number)
        ? int(data.totalXp)
        : computeLegacyTotalXpRule(data.level, data.xp);
    }

    function existingCurrentPointsRule(data) {
      return ('currentPoints' in data && data.currentPoints is number)
        ? int(data.currentPoints)
        : int(data.points);
    }

    function existingTotalPointsEarnedRule(data) {
      return ('totalPointsEarned' in data && data.totalPointsEarned is number)
        ? int(data.totalPointsEarned)
        : existingCurrentPointsRule(data);
    }

    // Entity Blueprint Validators (Anti-Update-Gap)
    function isValidUserCreateKeys(data) {
      return data.keys().hasOnly([
        'id', 'playerId', 'displayName', 'email', 'photoURL',
        'level', 'xp', 'totalXp',
        'points', 'currentPoints', 'totalPointsEarned',
        'totalWins', 'totalGames',
        'activeFrame', 'activeBoardSkin', 'activeDiceSkin', 'activeTokenSkin',
        'inventory', 'claimedAchievements',
        'lastClaimId', 'lastDailyClaimId', 'lastAchievementClaimId',
        'activeRoomId', 'activeRoomCode', 'activeGameType',
        'createdAt', 'updatedAt'
      ]);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'playerId', 'displayName', 'level', 'xp', 'points', 'totalWins', 'totalGames', 'inventory']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.playerId is string && data.playerId.size() >= 2 && data.playerId.size() <= 24 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        data.level is number && data.level >= 1 && data.level <= 999 &&
        data.xp is number && data.xp >= 0 &&
        (!('totalXp' in data) || (data.totalXp is number && data.totalXp >= 0)) &&
        data.points is number && data.points >= 0 &&
        (!('currentPoints' in data) || (data.currentPoints is number && data.currentPoints == data.points)) &&
        (!('totalPointsEarned' in data) || (data.totalPointsEarned is number && data.totalPointsEarned >= data.points)) &&
        data.totalWins is number && data.totalWins >= 0 &&
        data.totalGames is number && data.totalGames >= 0 &&
        (!('activeFrame' in data) || (data.activeFrame is string && data.activeFrame.size() <= 50)) &&
        (!('activeBoardSkin' in data) || (data.activeBoardSkin is string && data.activeBoardSkin.size() <= 50)) &&
        (!('activeDiceSkin' in data) || (data.activeDiceSkin is string && data.activeDiceSkin.size() <= 50)) &&
        (!('activeTokenSkin' in data) || (data.activeTokenSkin is string && data.activeTokenSkin.size() <= 50)) &&
        data.inventory is list && data.inventory.size() <= 50 &&
        (data.inventory.size() == 0 || (data.inventory[0] is string && data.inventory[0].size() <= 50)) &&
        (!('claimedAchievements' in data) || (
          data.claimedAchievements is list && data.claimedAchievements.size() <= 30 &&
          (data.claimedAchievements.size() == 0 || (data.claimedAchievements[0] is string && data.claimedAchievements[0].size() <= 40))
        )) &&
        (!('lastClaimId' in data) || data.lastClaimId == null || (data.lastClaimId is string && data.lastClaimId.size() <= 128)) &&
        (!('lastDailyClaimId' in data) || data.lastDailyClaimId == null || (data.lastDailyClaimId is string && data.lastDailyClaimId.size() <= 128)) &&
        (!('lastAchievementClaimId' in data) || data.lastAchievementClaimId == null || (data.lastAchievementClaimId is string && data.lastAchievementClaimId.size() <= 128)) &&
        (!('activeRoomId' in data) || data.activeRoomId == null || (data.activeRoomId is string && data.activeRoomId.size() <= 64)) &&
        (!('activeRoomCode' in data) || data.activeRoomCode == null || (data.activeRoomCode is string && data.activeRoomCode.size() <= 16)) &&
        (!('activeGameType' in data) || data.activeGameType == null || (data.activeGameType is string && data.activeGameType.size() <= 40)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    // Room Player & Roster Validation Helpers (Bounded 1..4 Players, Zero Loops)
    function isAllowedRoomGameType(gameType) {
      return gameType is string && gameType in ['snakes_and_ladders', 'snow_rush'];
    }

    function isValidRoomPlayer(p) {
      return p is map &&
        p.keys().hasAll(['uid', 'displayName', 'isReady', 'position']) &&
        p.keys().hasOnly([
          'uid', 'playerId', 'displayName', 'photoURL', 'isReady', 'color',
          'position', 'positionVersion', 'lastMoveId', 'updatedAtMs',
          'activeTokenSkin', 'isConnected', 'lastSeen', 'rank', 'disconnectedAt'
        ]) &&
        p.uid is string && p.uid.size() >= 1 && p.uid.size() <= 128 &&
        (!('playerId' in p) || (p.playerId is string && p.playerId.size() <= 32)) &&
        p.displayName is string && p.displayName.size() >= 1 && p.displayName.size() <= 60 &&
        (!('photoURL' in p) || (p.photoURL is string && p.photoURL.size() <= 1000)) &&
        p.isReady is bool &&
        (!('color' in p) || (p.color is string && p.color.size() <= 24)) &&
        p.position is number && p.position >= 1 && p.position <= 100 &&
        (!('positionVersion' in p) || (p.positionVersion is number && p.positionVersion >= 1)) &&
        (!('lastMoveId' in p) || p.lastMoveId == null || (p.lastMoveId is string && p.lastMoveId.size() <= 80)) &&
        (!('updatedAtMs' in p) || (p.updatedAtMs is number && p.updatedAtMs >= 0)) &&
        (!('activeTokenSkin' in p) || (p.activeTokenSkin is string && p.activeTokenSkin.size() <= 50)) &&
        (!('isConnected' in p) || p.isConnected is bool) &&
        (!('lastSeen' in p) || (p.lastSeen is number && p.lastSeen >= 0)) &&
        (!('rank' in p) || (p.rank is number && p.rank >= 1 && p.rank <= 4)) &&
        (!('disconnectedAt' in p) || p.disconnectedAt == null || (p.disconnectedAt is number && p.disconnectedAt >= 0));
    }

    function areAllRoomPlayersValid(players) {
      return players is list && players.size() >= 1 && players.size() <= 4 &&
        isValidRoomPlayer(players[0]) &&
        (players.size() < 2 || isValidRoomPlayer(players[1])) &&
        (players.size() < 3 || isValidRoomPlayer(players[2])) &&
        (players.size() < 4 || isValidRoomPlayer(players[3]));
    }

    function hasUniquePlayerUids(players) {
      return (players.size() < 2 || players[0].uid != players[1].uid) &&
        (players.size() < 3 || (players[0].uid != players[2].uid && players[1].uid != players[2].uid)) &&
        (players.size() < 4 || (players[0].uid != players[3].uid && players[1].uid != players[3].uid && players[2].uid != players[3].uid));
    }

    function isPlayerInList(players, uid) {
      return players is list && (
        (players.size() >= 1 && players[0].uid == uid) ||
        (players.size() >= 2 && players[1].uid == uid) ||
        (players.size() >= 3 && players[2].uid == uid) ||
        (players.size() >= 4 && players[3].uid == uid)
      );
    }

    function samePlayerRosterUids(oldPlayers, newPlayers) {
      return oldPlayers.size() == newPlayers.size() &&
        (oldPlayers.size() < 1 || oldPlayers[0].uid == newPlayers[0].uid) &&
        (oldPlayers.size() < 2 || oldPlayers[1].uid == newPlayers[1].uid) &&
        (oldPlayers.size() < 3 || oldPlayers[2].uid == newPlayers[2].uid) &&
        (oldPlayers.size() < 4 || oldPlayers[3].uid == newPlayers[3].uid);
    }

    function samePlayerPositions(oldPlayers, newPlayers) {
      return oldPlayers.size() == newPlayers.size() &&
        (oldPlayers.size() < 1 || oldPlayers[0].position == newPlayers[0].position) &&
        (oldPlayers.size() < 2 || oldPlayers[1].position == newPlayers[1].position) &&
        (oldPlayers.size() < 3 || oldPlayers[2].position == newPlayers[2].position) &&
        (oldPlayers.size() < 4 || oldPlayers[3].position == newPlayers[3].position);
    }

    function samePlayersReady(oldPlayers, newPlayers) {
      return oldPlayers.size() == newPlayers.size() &&
        (oldPlayers.size() < 1 || oldPlayers[0].isReady == newPlayers[0].isReady) &&
        (oldPlayers.size() < 2 || oldPlayers[1].isReady == newPlayers[1].isReady) &&
        (oldPlayers.size() < 3 || oldPlayers[2].isReady == newPlayers[2].isReady) &&
        (oldPlayers.size() < 4 || oldPlayers[3].isReady == newPlayers[3].isReady);
    }

    function onlyCallerChangedReady(oldPlayers, newPlayers, callerUid) {
      return oldPlayers.size() == newPlayers.size() &&
        (oldPlayers.size() < 1 || oldPlayers[0].uid == callerUid || oldPlayers[0].isReady == newPlayers[0].isReady) &&
        (oldPlayers.size() < 2 || oldPlayers[1].uid == callerUid || oldPlayers[1].isReady == newPlayers[1].isReady) &&
        (oldPlayers.size() < 3 || oldPlayers[2].uid == callerUid || oldPlayers[2].isReady == newPlayers[2].isReady) &&
        (oldPlayers.size() < 4 || oldPlayers[3].uid == callerUid || oldPlayers[3].isReady == newPlayers[3].isReady);
    }

    function areAllNonHostPlayersReady(players, hostId) {
      return (players.size() < 1 || players[0].uid == hostId || players[0].isReady == true) &&
        (players.size() < 2 || players[1].uid == hostId || players[1].isReady == true) &&
        (players.size() < 3 || players[2].uid == hostId || players[2].isReady == true) &&
        (players.size() < 4 || players[3].uid == hostId || players[3].isReady == true);
    }

    function allPlayersAtStartPosition(players) {
      return (players.size() < 1 || players[0].position == 1) &&
        (players.size() < 2 || players[1].position == 1) &&
        (players.size() < 3 || players[2].position == 1) &&
        (players.size() < 4 || players[3].position == 1);
    }

    function preserveExistingPlayersOnJoin(oldPlayers, newPlayers, joinUid) {
      return newPlayers.size() == oldPlayers.size() + 1 &&
        (oldPlayers.size() < 1 || (oldPlayers[0].uid == newPlayers[0].uid && oldPlayers[0].isReady == newPlayers[0].isReady && oldPlayers[0].position == newPlayers[0].position)) &&
        (oldPlayers.size() < 2 || (oldPlayers[1].uid == newPlayers[1].uid && oldPlayers[1].isReady == newPlayers[1].isReady && oldPlayers[1].position == newPlayers[1].position)) &&
        (oldPlayers.size() < 3 || (oldPlayers[2].uid == newPlayers[2].uid && oldPlayers[2].isReady == newPlayers[2].isReady && oldPlayers[2].position == newPlayers[2].position)) &&
        newPlayers[newPlayers.size() - 1].uid == joinUid &&
        newPlayers[newPlayers.size() - 1].isReady == false &&
        newPlayers[newPlayers.size() - 1].position == 1;
    }

    function playerMatchesPositionInExisting(p, oldPlayers) {
      return (oldPlayers.size() >= 1 && oldPlayers[0].uid == p.uid && oldPlayers[0].position == p.position) ||
        (oldPlayers.size() >= 2 && oldPlayers[1].uid == p.uid && oldPlayers[1].position == p.position) ||
        (oldPlayers.size() >= 3 && oldPlayers[2].uid == p.uid && oldPlayers[2].position == p.position) ||
        (oldPlayers.size() >= 4 && oldPlayers[3].uid == p.uid && oldPlayers[3].position == p.position);
    }

    function allRemainingPreservePositions(remPlayers, oldPlayers) {
      return (remPlayers.size() < 1 || playerMatchesPositionInExisting(remPlayers[0], oldPlayers)) &&
        (remPlayers.size() < 2 || playerMatchesPositionInExisting(remPlayers[1], oldPlayers)) &&
        (remPlayers.size() < 3 || playerMatchesPositionInExisting(remPlayers[2], oldPlayers));
    }

    function existingGameRound(roomData) {
      return ('gameRound' in roomData && roomData.gameRound is number) ? int(roomData.gameRound) : 1;
    }

    function hasMonotonicStateVersion(oldRoom, newRoom) {
      return ('stateVersion' in newRoom) &&
        newRoom.stateVersion is number &&
        (!('stateVersion' in oldRoom) || newRoom.stateVersion > oldRoom.stateVersion);
    }

    function isCurrentTurnPlayer(roomData, uid) {
      return ('currentTurnIndex' in roomData) &&
        roomData.currentTurnIndex is int &&
        roomData.currentTurnIndex >= 0 &&
        roomData.currentTurnIndex < roomData.players.size() &&
        roomData.players[roomData.currentTurnIndex].uid == uid;
    }

    function nonTurnPlayerPositionsUnchanged(oldPlayers, newPlayers, turnIdx) {
      return oldPlayers.size() == newPlayers.size() &&
        (oldPlayers.size() < 1 || turnIdx == 0 || oldPlayers[0].position == newPlayers[0].position) &&
        (oldPlayers.size() < 2 || turnIdx == 1 || oldPlayers[1].position == newPlayers[1].position) &&
        (oldPlayers.size() < 3 || turnIdx == 2 || oldPlayers[2].position == newPlayers[2].position) &&
        (oldPlayers.size() < 4 || turnIdx == 3 || oldPlayers[3].position == newPlayers[3].position);
    }

    // Verified Snakes & Ladders single-turn reachability (Dice 1..6 + Ladders 4->14, 9->31, 20->38, 28->84, 40->59, 51->67, 63->81, 71->91)
    function isValidSnakesTurnPositionStep(oldPos, newPos) {
      return newPos is number && newPos >= 1 && newPos <= 100 && (
        (newPos <= oldPos + 6 && (newPos != 100 || oldPos >= 94)) ||
        (newPos == 14 && oldPos >= 1 && oldPos <= 3) ||
        (newPos == 31 && oldPos >= 3 && oldPos <= 8) ||
        (newPos == 38 && oldPos >= 14 && oldPos <= 19) ||
        (newPos == 84 && oldPos >= 22 && oldPos <= 27) ||
        (newPos == 59 && oldPos >= 34 && oldPos <= 39) ||
        (newPos == 67 && oldPos >= 45 && oldPos <= 50) ||
        (newPos == 81 && oldPos >= 57 && oldPos <= 62) ||
        (newPos == 91 && oldPos >= 65 && oldPos <= 70)
      );
    }

    function isValidSnakesLeaveOutcome(oldRoom, newRoom) {
      return (
        oldRoom.status in ['waiting', 'full'] &&
        newRoom.winnerId == null &&
        (!('winnerName' in newRoom) || newRoom.winnerName == null) &&
        newRoom.status == (newRoom.players.size() >= newRoom.maxPlayers ? 'full' : 'waiting')
      ) || (
        oldRoom.status == 'playing' && (
          (newRoom.players.size() == 1 && newRoom.status == 'finished' && newRoom.winnerId == newRoom.players[0].uid) ||
          (newRoom.players.size() >= 2 && newRoom.status == 'playing' && newRoom.winnerId == null && (!('winnerName' in newRoom) || newRoom.winnerName == null))
        )
      ) || (
        oldRoom.status == 'finished' &&
        newRoom.status == 'finished' &&
        newRoom.winnerId == oldRoom.winnerId
      );
    }

    function isValidGameRoom(data) {
      return data.keys().hasAll(['id', 'roomCode', 'gameType', 'hostId', 'status', 'maxPlayers', 'players']) &&
        data.keys().hasOnly([
          'id', 'roomCode', 'gameType', 'hostId', 'hostName',
          'status', 'maxPlayers', 'playerCount', 'players',
          'currentTurnIndex', 'lastDiceRoll', 'lastMoveSummary',
          'winnerId', 'winnerName', 'matchParticipantIds', 'exactFinish',
          'stateVersion', 'gameRound', 'lastMoveId',
          'playerPositions', 'presence',
          'turnStartTimestamp', 'turnDeadline',
          'reconnectionDeadline', 'disconnectedPlayerId', 'disconnectedPlayerName',
          'lastMoveTimestamp', 'lastMovePath', 'lastMovingPlayerUid',
          'createdAt', 'updatedAt', 'timestamp', 'serverUpdatedAt'
        ]) &&
        data.id is string && data.id.size() >= 6 && data.id.size() <= 64 &&
        data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16 &&
        isAllowedRoomGameType(data.gameType) &&
        data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
        (!('hostName' in data) || (data.hostName is string && data.hostName.size() <= 60)) &&
        data.status in ['waiting', 'full', 'playing', 'finished'] &&
        data.maxPlayers is number && data.maxPlayers >= 2 && data.maxPlayers <= 4 &&
        areAllRoomPlayersValid(data.players) &&
        data.players.size() <= data.maxPlayers &&
        hasUniquePlayerUids(data.players) &&
        isPlayerInList(data.players, data.hostId) &&
        (!('playerCount' in data) || (data.playerCount is number && data.playerCount == data.players.size())) &&
        (!('currentTurnIndex' in data) || (data.currentTurnIndex is int && data.currentTurnIndex >= 0 && data.currentTurnIndex < 4)) &&
        (!('lastDiceRoll' in data) || (data.lastDiceRoll is int && data.lastDiceRoll >= 1 && data.lastDiceRoll <= 6)) &&
        (!('matchParticipantIds' in data) || (
          data.matchParticipantIds is list && data.matchParticipantIds.size() <= 4 &&
          (data.matchParticipantIds.size() == 0 || (data.matchParticipantIds[0] is string && data.matchParticipantIds[0].size() <= 128))
        )) &&
        (!('exactFinish' in data) || data.exactFinish is bool) &&
        (!('stateVersion' in data) || (data.stateVersion is number && data.stateVersion >= 1)) &&
        (!('gameRound' in data) || (data.gameRound is int && data.gameRound >= 1)) &&
        (!('lastMoveId' in data) || data.lastMoveId == null || (data.lastMoveId is string && data.lastMoveId.size() <= 80)) &&
        (!('playerPositions' in data) || (data.playerPositions is map && data.playerPositions.size() <= 4)) &&
        (!('presence' in data) || (data.presence is map && data.presence.size() <= 16)) &&
        (!('turnStartTimestamp' in data) || (data.turnStartTimestamp is number && data.turnStartTimestamp >= 0)) &&
        (!('turnDeadline' in data) || (data.turnDeadline is number && data.turnDeadline >= 0)) &&
        (!('reconnectionDeadline' in data) || data.reconnectionDeadline == null || (data.reconnectionDeadline is number && data.reconnectionDeadline >= 0)) &&
        (!('disconnectedPlayerId' in data) || data.disconnectedPlayerId == null || (data.disconnectedPlayerId is string && data.disconnectedPlayerId.size() <= 128)) &&
        (!('disconnectedPlayerName' in data) || data.disconnectedPlayerName == null || (data.disconnectedPlayerName is string && data.disconnectedPlayerName.size() <= 60)) &&
        (!('lastMoveTimestamp' in data) || (data.lastMoveTimestamp is number && data.lastMoveTimestamp >= 0)) &&
        (!('lastMoveSummary' in data) || (data.lastMoveSummary is string && data.lastMoveSummary.size() <= 500)) &&
        (!('winnerId' in data) || data.winnerId == null || (data.winnerId is string && data.winnerId.size() >= 1 && data.winnerId.size() <= 128)) &&
        (!('winnerName' in data) || data.winnerName == null || (data.winnerName is string && data.winnerName.size() <= 60)) &&
        (!('lastMovePath' in data) || (data.lastMovePath is list && data.lastMovePath.size() <= 20)) &&
        (!('lastMovingPlayerUid' in data) || data.lastMovingPlayerUid == null || (data.lastMovingPlayerUid is string && data.lastMovingPlayerUid.size() <= 128)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40)) &&
        (!('timestamp' in data) || data.timestamp is timestamp) &&
        (!('serverUpdatedAt' in data) || data.serverUpdatedAt is timestamp) &&
        // Phase 1 Snow Rush Result Lock: Client can NEVER set status == 'finished' or winnerId/winnerName on Snow Rush rooms
        (
          data.gameType != 'snow_rush' || (
            data.status in ['waiting', 'full', 'playing'] &&
            (!('winnerId' in data) || data.winnerId == null) &&
            (!('winnerName' in data) || data.winnerName == null)
          )
        );
    }

    function isValidMatchRewardClaim(data) {
      return data.keys().hasAll(['id', 'userId', 'roomId', 'gameRound', 'outcome', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'roomId', 'gameRound', 'outcome', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.roomId is string && data.roomId.size() <= 64 && isValidId(data.roomId) &&
        data.gameRound is int && data.gameRound >= 1 &&
        data.outcome in ['win', 'loss'] &&
        data.xpGranted is int && (data.xpGranted == 100 || data.xpGranted == 75) &&
        data.pointsGranted is int && (data.pointsGranted == 1000 || data.pointsGranted == 500) &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.serverCreatedAt == request.time;
    }

    function isValidDailyClaim(data) {
      return data.keys().hasAll(['id', 'userId', 'dayBucket', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'dayBucket', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.dayBucket is int && data.dayBucket >= 19000 &&
        data.xpGranted == 80 &&
        data.pointsGranted == 100 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.serverCreatedAt == request.time;
    }

    function isValidAchievementClaim(data) {
      return data.keys().hasAll(['id', 'userId', 'achievementId', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'achievementId', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.achievementId is string && data.achievementId in ['first_win', 'win_5', 'games_10', 'reach_lvl_5'] &&
        data.xpGranted is int && data.xpGranted > 0 &&
        data.pointsGranted is int && data.pointsGranted > 0 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.serverCreatedAt == request.time;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'description', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'type', 'amount', 'xpAmount', 'description', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.type is string && data.type.size() <= 40 &&
        data.amount is number &&
        (!('xpAmount' in data) || (data.xpAmount is number && data.xpAmount >= 0)) &&
        data.description is string && data.description.size() <= 240 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Verified Match Outcome Relational Helper (Phase 1: Restricted strictly to snakes_and_ladders)
    function isServerVerifiedMatchReward(claim) {
      let room = get(/databases/$(database)/documents/rooms/$(claim.roomId)).data;
      let roomRound = ('gameRound' in room && room.gameRound is number) ? int(room.gameRound) : 1;
      let isParticipant =
        room.winnerId == request.auth.uid ||
        ('matchParticipantIds' in room && room.matchParticipantIds is list && request.auth.uid in room.matchParticipantIds) ||
        ('playerPositions' in room && room.playerPositions is map && request.auth.uid in room.playerPositions);

      return room.gameType == 'snakes_and_ladders' &&
        room.status == 'finished' &&
        room.winnerId is string && room.winnerId.size() > 0 &&
        roomRound == claim.gameRound &&
        isParticipant &&
        (
          (room.winnerId == request.auth.uid && claim.outcome == 'win' && claim.xpGranted == 100 && claim.pointsGranted == 1000) ||
          (room.winnerId != request.auth.uid && claim.outcome == 'loss' && claim.xpGranted == 75 && claim.pointsGranted == 500)
        );
    }

    // Verified Achievement Eligibility Helper
    function isServerVerifiedAchievementReward(claim) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (claim.achievementId == 'first_win' && user.totalWins >= 1 && claim.xpGranted == 150 && claim.pointsGranted == 100) ||
        (claim.achievementId == 'win_5' && user.totalWins >= 5 && claim.xpGranted == 400 && claim.pointsGranted == 300) ||
        (claim.achievementId == 'games_10' && user.totalGames >= 10 && claim.xpGranted == 300 && claim.pointsGranted == 200) ||
        (claim.achievementId == 'reach_lvl_5' && user.level >= 5 && claim.xpGranted == 500 && claim.pointsGranted == 500);
    }

    // 1. Users Collection (Anti-Tamper Action-Based Progression & Separated Point Balances)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUserCreateKeys(incoming()) &&
        isValidUser(incoming()) &&
        incoming().level == 1 &&
        incoming().xp == 0 &&
        incoming().totalXp == 0 &&
        incoming().points == 500 &&
        incoming().currentPoints == 500 &&
        incoming().totalPointsEarned == 500 &&
        incoming().totalWins == 0 &&
        incoming().totalGames == 0;

      allow update: if isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().playerId == existing().playerId && (
          // Action 1: Non-Economy Profile, Cosmetic Equip, or Active Room Session Update
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'photoURL',
              'activeFrame', 'activeBoardSkin', 'activeDiceSkin', 'activeTokenSkin',
              'activeRoomId', 'activeRoomCode', 'activeGameType',
              'updatedAt'
            ])
          ) ||
          // Action 2: One-Time Backward-Compatible Normalization for Pre-Upgrade Accounts
          (
            (!('totalXp' in existing()) || !('totalPointsEarned' in existing()) || !('currentPoints' in existing())) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned', 'updatedAt'
            ]) &&
            int(incoming().points) == int(existing().points) &&
            int(incoming().currentPoints) == int(existing().points) &&
            int(incoming().totalPointsEarned) == existingTotalPointsEarnedRule(existing()) &&
            int(incoming().totalXp) == existingTotalXpRule(existing()) &&
            int(incoming().level) == computeLevelRule(incoming().totalXp) &&
            int(incoming().xp) == computeCurrentLevelXpRule(incoming().totalXp)
          ) ||
          // Action 3: Server-Verified Atomic Match Reward Claim (+100 XP/+1000 Pts Win, +75 XP/+500 Pts Loss)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned',
              'totalGames', 'totalWins', 'lastClaimId', 'updatedAt'
            ]) &&
            incoming().lastClaimId is string && isValidId(incoming().lastClaimId) &&
            !exists(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)) &&
            existsAfter(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)) &&
            getAfter(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)).data.userId == userId &&
            int(incoming().totalXp) == existingTotalXpRule(existing()) + getAfter(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)).data.xpGranted &&
            int(incoming().level) == computeLevelRule(incoming().totalXp) &&
            int(incoming().xp) == computeCurrentLevelXpRule(incoming().totalXp) &&
            int(incoming().points) == existingCurrentPointsRule(existing()) + getAfter(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)).data.pointsGranted &&
            int(incoming().currentPoints) == int(incoming().points) &&
            int(incoming().totalPointsEarned) == existingTotalPointsEarnedRule(existing()) + getAfter(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)).data.pointsGranted &&
            int(incoming().totalGames) == int(existing().totalGames) + 1 &&
            int(incoming().totalWins) == int(existing().totalWins) + (getAfter(/databases/$(database)/documents/reward_claims/$(incoming().lastClaimId)).data.outcome == 'win' ? 1 : 0)
          ) ||
          // Action 4: Server-Verified Atomic Daily Login Reward Claim
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned',
              'lastDailyClaimId', 'updatedAt'
            ]) &&
            incoming().lastDailyClaimId is string && isValidId(incoming().lastDailyClaimId) &&
            !exists(/databases/$(database)/documents/daily_claims/$(incoming().lastDailyClaimId)) &&
            existsAfter(/databases/$(database)/documents/daily_claims/$(incoming().lastDailyClaimId)) &&
            getAfter(/databases/$(database)/documents/daily_claims/$(incoming().lastDailyClaimId)).data.userId == userId &&
            int(incoming().totalXp) == existingTotalXpRule(existing()) + getAfter(/databases/$(database)/documents/daily_claims/$(incoming().lastDailyClaimId)).data.xpGranted &&
            int(incoming().level) == computeLevelRule(incoming().totalXp) &&
            int(incoming().xp) == computeCurrentLevelXpRule(incoming().totalXp) &&
            int(incoming().points) == existingCurrentPointsRule(existing()) + getAfter(/databases/$(database)/documents/daily_claims/$(incoming().lastDailyClaimId)).data.pointsGranted &&
            int(incoming().currentPoints) == int(incoming().points) &&
            int(incoming().totalPointsEarned) == existingTotalPointsEarnedRule(existing()) + getAfter(/databases/$(database)/documents/daily_claims/$(incoming().lastDailyClaimId)).data.pointsGranted
          ) ||
          // Action 5: Server-Verified Atomic Achievement Reward Claim
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned',
              'claimedAchievements', 'lastAchievementClaimId', 'updatedAt'
            ]) &&
            incoming().lastAchievementClaimId is string && isValidId(incoming().lastAchievementClaimId) &&
            !exists(/databases/$(database)/documents/achievement_claims/$(incoming().lastAchievementClaimId)) &&
            existsAfter(/databases/$(database)/documents/achievement_claims/$(incoming().lastAchievementClaimId)) &&
            getAfter(/databases/$(database)/documents/achievement_claims/$(incoming().lastAchievementClaimId)).data.userId == userId &&
            int(incoming().totalXp) == existingTotalXpRule(existing()) + getAfter(/databases/$(database)/documents/achievement_claims/$(incoming().lastAchievementClaimId)).data.xpGranted &&
            int(incoming().level) == computeLevelRule(incoming().totalXp) &&
            int(incoming().xp) == computeCurrentLevelXpRule(incoming().totalXp) &&
            int(incoming().points) == existingCurrentPointsRule(existing()) + getAfter(/databases/$(database)/documents/achievement_claims/$(incoming().lastAchievementClaimId)).data.pointsGranted &&
            int(incoming().currentPoints) == int(incoming().points) &&
            int(incoming().totalPointsEarned) == existingTotalPointsEarnedRule(existing()) + getAfter(/databases/$(database)/documents/achievement_claims/$(incoming().lastAchievementClaimId)).data.pointsGranted
          ) ||
          // Action 6: Shop Item Purchase (Deducts ONLY Current Points; Total Points Earned & XP/Level Unchanged!)
          (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'points', 'currentPoints', 'totalPointsEarned',
              'totalXp', 'level', 'xp', 'inventory', 'updatedAt'
            ]) &&
            incoming().inventory.size() == existing().inventory.size() + 1 &&
            int(incoming().points) <= existingCurrentPointsRule(existing()) &&
            int(incoming().points) >= 0 &&
            int(incoming().currentPoints) == int(incoming().points) &&
            int(incoming().totalPointsEarned) == existingTotalPointsEarnedRule(existing()) &&
            int(incoming().totalXp) == existingTotalXpRule(existing()) &&
            int(incoming().level) == computeLevelRule(incoming().totalXp) &&
            int(incoming().xp) == computeCurrentLevelXpRule(incoming().totalXp)
          )
        );

      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Game Rooms Collection (Action-Based Member/Host/Turn Security + Snow Rush Phase 1 Lock)
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && resource.data.status in ['waiting', 'full', 'playing', 'finished'];

      allow create: if isSignedIn() &&
        isValidId(roomId) &&
        isValidGameRoom(incoming()) &&
        incoming().id == roomId &&
        roomId == 'room_' + incoming().roomCode &&
        incoming().hostId == request.auth.uid &&
        incoming().status == 'waiting' &&
        (!('winnerId' in incoming()) || incoming().winnerId == null) &&
        (!('winnerName' in incoming()) || incoming().winnerName == null) &&
        incoming().players.size() == 1 &&
        incoming().players[0].uid == request.auth.uid &&
        incoming().players[0].position == 1 &&
        (!('playerCount' in incoming()) || incoming().playerCount == 1) &&
        ('gameRound' in incoming()) && incoming().gameRound == 1 &&
        ('stateVersion' in incoming()) && incoming().stateVersion == 1 &&
        (!('timestamp' in incoming()) || incoming().timestamp == request.time) &&
        (!('serverUpdatedAt' in incoming()) || incoming().serverUpdatedAt == request.time);

      allow update: if isSignedIn() &&
        isValidId(roomId) &&
        isValidGameRoom(incoming()) &&
        // Universal Immutable Room Identity Fields
        incoming().id == existing().id &&
        incoming().roomCode == existing().roomCode &&
        incoming().gameType == existing().gameType &&
        incoming().maxPlayers == existing().maxPlayers &&
        (!('createdAt' in existing()) ? !('createdAt' in incoming()) : incoming().createdAt == existing().createdAt) && (
          // Action 1: Member-Only Isolated Presence Heartbeat
          (
            isPlayerInList(existing().players, request.auth.uid) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['presence']) &&
            incoming().presence is map &&
            (
              !('presence' in existing()) ||
              !(existing().presence is map) ||
              incoming().presence.diff(existing().presence).affectedKeys().hasOnly([request.auth.uid])
            )
          ) ||
          // Action 2: New Player Join Waiting Room (Appends Self Only)
          (
            existing().status == 'waiting' &&
            !isPlayerInList(existing().players, request.auth.uid) &&
            existing().players.size() >= 1 &&
            existing().players.size() < existing().maxPlayers &&
            preserveExistingPlayersOnJoin(existing().players, incoming().players, request.auth.uid) &&
            incoming().hostId == existing().hostId &&
            existingGameRound(incoming()) == existingGameRound(existing()) &&
            (!('winnerId' in incoming()) || incoming().winnerId == null) &&
            (!('winnerName' in incoming()) || incoming().winnerName == null) &&
            incoming().status == (incoming().players.size() >= incoming().maxPlayers ? 'full' : 'waiting') &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'playerCount', 'maxPlayers', 'status',
              'winnerId', 'winnerName', 'playerPositions', 'presence',
              'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
            ])
          ) ||
          // Action 3: Existing Member Lobby Ready Toggle / Reconnect Sync
          (
            isPlayerInList(existing().players, request.auth.uid) &&
            existing().status in ['waiting', 'full', 'playing'] &&
            samePlayerRosterUids(existing().players, incoming().players) &&
            samePlayerPositions(existing().players, incoming().players) &&
            onlyCallerChangedReady(existing().players, incoming().players, request.auth.uid) &&
            incoming().hostId == existing().hostId &&
            existingGameRound(incoming()) == existingGameRound(existing()) &&
            incoming().winnerId == existing().winnerId &&
            incoming().status == (existing().status == 'playing' ? 'playing' : (incoming().players.size() >= incoming().maxPlayers ? 'full' : 'waiting')) &&
            (
              !('disconnectedPlayerId' in incoming().diff(existing()).affectedKeys()) ||
              (existing().disconnectedPlayerId == request.auth.uid && incoming().disconnectedPlayerId == null && incoming().reconnectionDeadline == null)
            ) &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'playerCount', 'maxPlayers', 'status',
              'winnerId', 'winnerName', 'playerPositions', 'presence',
              'disconnectedPlayerId', 'disconnectedPlayerName', 'reconnectionDeadline',
              'lastMoveSummary', 'stateVersion', 'updatedAt', 'serverUpdatedAt'
            ])
          ) ||
          // Action 4: Host Start Game (waiting | full -> playing; requires >= 2 players & non-host ready)
          (
            existing().hostId == request.auth.uid &&
            incoming().hostId == existing().hostId &&
            existing().status in ['waiting', 'full'] &&
            incoming().status == 'playing' &&
            existing().players.size() >= 2 &&
            existing().players.size() <= existing().maxPlayers &&
            areAllNonHostPlayersReady(existing().players, existing().hostId) &&
            samePlayerRosterUids(existing().players, incoming().players) &&
            allPlayersAtStartPosition(incoming().players) &&
            (!('winnerId' in incoming()) || incoming().winnerId == null) &&
            (!('winnerName' in incoming()) || incoming().winnerName == null) &&
            ('gameRound' in incoming()) && incoming().gameRound is int &&
            incoming().gameRound == existingGameRound(existing()) + 1 &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'players', 'playerCount', 'playerPositions',
              'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
              'reconnectionDeadline', 'disconnectedPlayerId', 'disconnectedPlayerName',
              'lastMoveId', 'lastMovePath', 'lastMovingPlayerUid',
              'winnerId', 'winnerName', 'matchParticipantIds',
              'gameRound', 'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
            ])
          ) ||
          // Action 5: Snakes & Ladders Active Turn Dice Roll & Verified Tile Progression
          (
            existing().gameType == 'snakes_and_ladders' &&
            existing().status == 'playing' &&
            (!('winnerId' in existing()) || existing().winnerId == null) &&
            isCurrentTurnPlayer(existing(), request.auth.uid) &&
            samePlayerRosterUids(existing().players, incoming().players) &&
            nonTurnPlayerPositionsUnchanged(existing().players, incoming().players, existing().currentTurnIndex) &&
            isValidSnakesTurnPositionStep(
              existing().players[existing().currentTurnIndex].position,
              incoming().players[existing().currentTurnIndex].position
            ) &&
            incoming().lastDiceRoll is int && incoming().lastDiceRoll >= 1 && incoming().lastDiceRoll <= 6 &&
            incoming().lastMovingPlayerUid == request.auth.uid &&
            incoming().hostId == existing().hostId &&
            existingGameRound(incoming()) == existingGameRound(existing()) &&
            (
              incoming().status == 'playing'
                ? ((!('winnerId' in incoming()) || incoming().winnerId == null) && (!('winnerName' in incoming()) || incoming().winnerName == null))
                : (
                  incoming().status == 'finished' &&
                  incoming().winnerId == request.auth.uid &&
                  existing().players[existing().currentTurnIndex].position >= 94 &&
                  incoming().players[existing().currentTurnIndex].position == 100
                )
            ) &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'playerPositions', 'presence',
              'lastDiceRoll', 'lastMoveSummary', 'lastMoveId', 'lastMoveTimestamp',
              'lastMovePath', 'lastMovingPlayerUid',
              'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
              'stateVersion', 'status', 'winnerId', 'winnerName',
              'matchParticipantIds', 'updatedAt', 'serverUpdatedAt'
            ])
          ) ||
          // Action 6: Snakes & Ladders Disconnect / Reconnection Timeout / Turn Timeout Recovery
          (
            existing().gameType == 'snakes_and_ladders' &&
            isPlayerInList(existing().players, request.auth.uid) &&
            existing().status in ['waiting', 'full', 'playing'] &&
            incoming().status == existing().status &&
            samePlayerRosterUids(existing().players, incoming().players) &&
            samePlayerPositions(existing().players, incoming().players) &&
            samePlayersReady(existing().players, incoming().players) &&
            incoming().hostId == existing().hostId &&
            existingGameRound(incoming()) == existingGameRound(existing()) &&
            incoming().winnerId == existing().winnerId &&
            (
              !('disconnectedPlayerId' in incoming().diff(existing()).affectedKeys()) ||
              incoming().disconnectedPlayerId == request.auth.uid ||
              incoming().disconnectedPlayerId == null
            ) &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'playerPositions', 'presence',
              'disconnectedPlayerId', 'disconnectedPlayerName', 'reconnectionDeadline',
              'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
              'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
            ])
          ) ||
          // Action 7: Member Leave Room (Self-Removal + Host Promotion; Snow Rush Never Sets Finished/Winner)
          (
            isPlayerInList(existing().players, request.auth.uid) &&
            !isPlayerInList(incoming().players, request.auth.uid) &&
            existing().players.size() >= 2 &&
            incoming().players.size() == existing().players.size() - 1 &&
            allRemainingPreservePositions(incoming().players, existing().players) &&
            (
              existing().hostId == request.auth.uid
                ? incoming().hostId == incoming().players[0].uid
                : incoming().hostId == existing().hostId
            ) &&
            existingGameRound(incoming()) == existingGameRound(existing()) &&
            (
              existing().gameType == 'snow_rush'
                ? (
                  (!('winnerId' in incoming()) || incoming().winnerId == null) &&
                  (!('winnerName' in incoming()) || incoming().winnerName == null) &&
                  incoming().status == (
                    existing().status == 'playing'
                      ? (incoming().players.size() >= 2 ? 'playing' : 'waiting')
                      : (incoming().players.size() >= incoming().maxPlayers ? 'full' : 'waiting')
                  )
                )
                : isValidSnakesLeaveOutcome(existing(), incoming())
            ) &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'playerCount', 'status', 'playerPositions',
              'hostId', 'hostName',
              'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
              'winnerId', 'winnerName', 'matchParticipantIds',
              'disconnectedPlayerId', 'disconnectedPlayerName', 'reconnectionDeadline',
              'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
            ])
          ) ||
          // Action 8: Snakes & Ladders Host Play Again Reset (finished -> waiting | full, gameRound + 1)
          (
            existing().gameType == 'snakes_and_ladders' &&
            existing().status == 'finished' &&
            existing().hostId == request.auth.uid &&
            incoming().hostId == existing().hostId &&
            samePlayerRosterUids(existing().players, incoming().players) &&
            allPlayersAtStartPosition(incoming().players) &&
            incoming().status == (incoming().players.size() >= incoming().maxPlayers ? 'full' : 'waiting') &&
            (!('winnerId' in incoming()) || incoming().winnerId == null) &&
            (!('winnerName' in incoming()) || incoming().winnerName == null) &&
            ('gameRound' in incoming()) && incoming().gameRound is int &&
            incoming().gameRound == existingGameRound(existing()) + 1 &&
            hasMonotonicStateVersion(existing(), incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'players', 'playerCount', 'playerPositions', 'status',
              'currentTurnIndex', 'lastDiceRoll', 'gameRound', 'stateVersion',
              'lastMoveId', 'lastMovePath', 'lastMovingPlayerUid',
              'turnStartTimestamp', 'turnDeadline',
              'reconnectionDeadline', 'disconnectedPlayerId', 'disconnectedPlayerName',
              'lastMoveSummary', 'winnerId', 'winnerName', 'matchParticipantIds',
              'lastMoveTimestamp', 'updatedAt', 'serverUpdatedAt'
            ])
          )
        );

      allow delete: if isSignedIn() &&
        isValidId(roomId) &&
        isPlayerInList(existing().players, request.auth.uid) &&
        (
          existing().players.size() == 1 ||
          (existing().hostId == request.auth.uid && existing().status != 'playing')
        );
    }

    // 3. Immutable Match Reward Claims (Idempotency + Server Outcome Verification)
    match /reward_claims/{claimId} {
      allow get: if isSignedIn() && isValidId(claimId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(claimId) &&
        isValidMatchRewardClaim(incoming()) &&
        incoming().id == claimId &&
        claimId == incoming().roomId + '_r' + string(incoming().gameRound) + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
        isServerVerifiedMatchReward(incoming());
      allow update, delete: if false;
    }

    // 4. Immutable Daily Login Reward Claims
    match /daily_claims/{dailyClaimId} {
      allow get: if isSignedIn() && isValidId(dailyClaimId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(dailyClaimId) &&
        isValidDailyClaim(incoming()) &&
        incoming().id == dailyClaimId &&
        dailyClaimId == request.auth.uid + '_d' + string(incoming().dayBucket) &&
        incoming().dayBucket >= (request.time.toMillis() / 86400000) - 1 &&
        incoming().dayBucket <= (request.time.toMillis() / 86400000) + 1;
      allow update, delete: if false;
    }

    // 5. Immutable Achievement Reward Claims
    match /achievement_claims/{achClaimId} {
      allow get: if isSignedIn() && isValidId(achClaimId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(achClaimId) &&
        isValidAchievementClaim(incoming()) &&
        incoming().id == achClaimId &&
        achClaimId == request.auth.uid + '_ach_' + incoming().achievementId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isServerVerifiedAchievementReward(incoming());
      allow update, delete: if false;
    }

    // 6. Point & XP Transactions Ledger
    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(txId) &&
        isValidTransaction(incoming());
      allow update, delete: if false;
    }
  }
}
