rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(userId) ||
        // Allow updating game stats / points when finished game if player is in room
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalGames', 'totalWins', 'points', 'xp', 'level', 'updatedAt'])
      );
      allow delete: if isOwner(userId);
    }

    // Game Rooms Collection
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn() && (
        // Allow isolated presence heartbeats that never touch players or positions
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['presence']) ||
        // Allow upgrading legacy rooms that do not yet have stateVersion
        !('stateVersion' in resource.data) ||
        // Enforce strictly monotonic stateVersion on all game/player state updates to reject stale writes
        ('stateVersion' in request.resource.data &&
          request.resource.data.stateVersion is number &&
          request.resource.data.stateVersion > resource.data.stateVersion)
      );
      allow delete: if isSignedIn() && (resource.data.hostId == request.auth.uid || resource.data.players.size() <= 1);
    }

    // Transactions Ledger
    match /transactions/{txId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
