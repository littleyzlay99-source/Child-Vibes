rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny Catch-All First)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Deterministic Level 1-999 Curve Helpers (Mirrors progressionService.ts bit-for-bit)
    // Lv 1-100: 150 XP/level (15,000 XP span); Lv 101-999: 300 XP/level (284,400 XP total to Lv 999)
    function computeLevelRule(totalXp) {
      return int(totalXp) >= 284400
        ? 999
        : (int(totalXp) < 15000
          ? 1 + (int(totalXp) / 150)
          : 101 + ((int(totalXp) - 15000) / 300));
    }

    function computeCurrentLevelXpRule(totalXp) {
      return int(totalXp) >= 284400
        ? (int(totalXp) - 284400)
        : (int(totalXp) < 15000
          ? (int(totalXp) % 150)
          : ((int(totalXp) - 15000) % 300));
    }

    function computeLegacyTotalXpRule(lvl, xpVal) {
      let clampedLvl = int(lvl) < 1 ? 1 : (int(lvl) > 999 ? 999 : int(lvl));
      let safeXp = int(xpVal) < 0 ? 0 : int(xpVal);
      let base = clampedLvl <= 1
        ? 0
        : (clampedLvl <= 101
          ? (clampedLvl - 1) * 150
          : 15000 + (clampedLvl - 101) * 300);
      return base + safeXp;
    }

    function existingTotalXpRule(data) {
      return ('totalXp' in data && data.totalXp is number)
        ? int(data.totalXp)
        : computeLegacyTotalXpRule(data.level, data.xp);
    }

    function existingCurrentPointsRule(data) {
      return ('currentPoints' in data && data.currentPoints is number)
        ? int(data.currentPoints)
        : int(data.points);
    }

    function existingTotalPointsEarnedRule(data) {
      return ('totalPointsEarned' in data && data.totalPointsEarned is number)
        ? int(data.totalPointsEarned)
        : existingCurrentPointsRule(data);
    }

    // Entity Blueprint Validators (Anti-Update-Gap)
    function isValidUserCreateKeys(data) {
      return data.keys().hasOnly([
        'id', 'playerId', 'displayName', 'email', 'photoURL',
        'level', 'xp', 'totalXp',
        'points', 'currentPoints', 'totalPointsEarned',
        'totalWins', 'totalGames',
        'activeFrame', 'activeBoardSkin', 'activeDiceSkin', 'activeTokenSkin',
        'inventory', 'claimedAchievements',
        'lastClaimId', 'lastDailyClaimId', 'lastAchievementClaimId',
        'activeRoomId', 'activeRoomCode', 'activeGameType',
        'createdAt', 'updatedAt'
      ]);
    }

    function isValidUser(rawData) {
      let data = rawData;
      return data.keys().hasAll(['id', 'playerId', 'displayName', 'level', 'xp', 'points', 'totalWins', 'totalGames', 'inventory']) &&
        data.id is string && data.id.size() <= 128 && data.id == request.auth.uid &&
        data.playerId is string && data.playerId.size() >= 2 && data.playerId.size() <= 24 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
        (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        data.level is number && data.level >= 1 && data.level <= 999 &&
        data.xp is number && data.xp >= 0 &&
        (!('totalXp' in data) || (data.totalXp is number && data.totalXp >= 0)) &&
        data.points is number && data.points >= 0 &&
        (!('currentPoints' in data) || (data.currentPoints is number && data.currentPoints == data.points)) &&
        (!('totalPointsEarned' in data) || (data.totalPointsEarned is number && data.totalPointsEarned >= data.points)) &&
        data.totalWins is number && data.totalWins >= 0 &&
        data.totalGames is number && data.totalGames >= 0 &&
        (!('activeFrame' in data) || (data.activeFrame is string && data.activeFrame.size() <= 50)) &&
        (!('activeBoardSkin' in data) || (data.activeBoardSkin is string && data.activeBoardSkin.size() <= 50)) &&
        (!('activeDiceSkin' in data) || (data.activeDiceSkin is string && data.activeDiceSkin.size() <= 50)) &&
        (!('activeTokenSkin' in data) || (data.activeTokenSkin is string && data.activeTokenSkin.size() <= 50)) &&
        data.inventory is list && data.inventory.size() <= 50 &&
        (data.inventory.size() == 0 || (data.inventory[0] is string && data.inventory[0].size() <= 50)) &&
        (!('claimedAchievements' in data) || (
          data.claimedAchievements is list && data.claimedAchievements.size() <= 30 &&
          (data.claimedAchievements.size() == 0 || (data.claimedAchievements[0] is string && data.claimedAchievements[0].size() <= 40))
        )) &&
        (data.get('lastClaimId', null) == null || (data.lastClaimId is string && data.lastClaimId.size() <= 128)) &&
        (data.get('lastDailyClaimId', null) == null || (data.lastDailyClaimId is string && data.lastDailyClaimId.size() <= 128)) &&
        (data.get('lastAchievementClaimId', null) == null || (data.lastAchievementClaimId is string && data.lastAchievementClaimId.size() <= 128)) &&
        (data.get('activeRoomId', null) == null || (data.activeRoomId is string && data.activeRoomId.size() <= 64)) &&
        (data.get('activeRoomCode', null) == null || (data.activeRoomCode is string && data.activeRoomCode.size() <= 16)) &&
        (data.get('activeGameType', null) == null || (data.activeGameType is string && data.activeGameType.size() <= 40)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 40)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 40));
    }

    function canCreateUser(userId) {
      let inc = request.resource.data;
      return isOwner(userId) &&
        isValidId(userId) &&
        isValidUserCreateKeys(inc) &&
        isValidUser(inc) &&
        inc.level == 1 &&
        inc.xp == 0 &&
        inc.totalXp == 0 &&
        inc.points == 500 &&
        inc.currentPoints == 500 &&
        inc.totalPointsEarned == 500 &&
        inc.totalWins == 0 &&
        inc.totalGames == 0;
    }

    function isValidUserMatchRewardUpdate(inc, ext, userId) {
      let claimId = inc.lastClaimId;
      let claim = getAfter(/databases/$(database)/documents/reward_claims/$(claimId)).data;
      return claimId is string && isValidId(claimId) &&
        !exists(/databases/$(database)/documents/reward_claims/$(claimId)) &&
        existsAfter(/databases/$(database)/documents/reward_claims/$(claimId)) &&
        claim.userId == userId &&
        int(inc.totalXp) == existingTotalXpRule(ext) + claim.xpGranted &&
        int(inc.level) == computeLevelRule(inc.totalXp) &&
        int(inc.xp) == computeCurrentLevelXpRule(inc.totalXp) &&
        int(inc.points) == existingCurrentPointsRule(ext) + claim.pointsGranted &&
        int(inc.currentPoints) == int(inc.points) &&
        int(inc.totalPointsEarned) == existingTotalPointsEarnedRule(ext) + claim.pointsGranted &&
        int(inc.totalGames) == int(ext.totalGames) + 1 &&
        int(inc.totalWins) == int(ext.totalWins) + (claim.outcome == 'win' ? 1 : 0);
    }

    function isValidUserDailyRewardUpdate(inc, ext, userId) {
      let claimId = inc.lastDailyClaimId;
      let claim = getAfter(/databases/$(database)/documents/daily_claims/$(claimId)).data;
      return claimId is string && isValidId(claimId) &&
        !exists(/databases/$(database)/documents/daily_claims/$(claimId)) &&
        existsAfter(/databases/$(database)/documents/daily_claims/$(claimId)) &&
        claim.userId == userId &&
        int(inc.totalXp) == existingTotalXpRule(ext) + claim.xpGranted &&
        int(inc.level) == computeLevelRule(inc.totalXp) &&
        int(inc.xp) == computeCurrentLevelXpRule(inc.totalXp) &&
        int(inc.points) == existingCurrentPointsRule(ext) + claim.pointsGranted &&
        int(inc.currentPoints) == int(inc.points) &&
        int(inc.totalPointsEarned) == existingTotalPointsEarnedRule(ext) + claim.pointsGranted;
    }

    function isValidUserAchievementRewardUpdate(inc, ext, userId) {
      let claimId = inc.lastAchievementClaimId;
      let claim = getAfter(/databases/$(database)/documents/achievement_claims/$(claimId)).data;
      return claimId is string && isValidId(claimId) &&
        !exists(/databases/$(database)/documents/achievement_claims/$(claimId)) &&
        existsAfter(/databases/$(database)/documents/achievement_claims/$(claimId)) &&
        claim.userId == userId &&
        int(inc.totalXp) == existingTotalXpRule(ext) + claim.xpGranted &&
        int(inc.level) == computeLevelRule(inc.totalXp) &&
        int(inc.xp) == computeCurrentLevelXpRule(inc.totalXp) &&
        int(inc.points) == existingCurrentPointsRule(ext) + claim.pointsGranted &&
        int(inc.currentPoints) == int(inc.points) &&
        int(inc.totalPointsEarned) == existingTotalPointsEarnedRule(ext) + claim.pointsGranted;
    }

    function canUpdateUser(userId) {
      let inc = request.resource.data;
      let ext = resource.data;
      let changed = inc.diff(ext).affectedKeys();
      return isOwner(userId) &&
        isValidId(userId) &&
        isValidUser(inc) &&
        inc.id == ext.id &&
        inc.playerId == ext.playerId && (
          // Action 1: Non-Economy Profile, Cosmetic Equip, or Active Room Session Update
          changed.hasOnly([
            'displayName', 'photoURL',
            'activeFrame', 'activeBoardSkin', 'activeDiceSkin', 'activeTokenSkin',
            'activeRoomId', 'activeRoomCode', 'activeGameType',
            'updatedAt'
          ]) ||
          // Action 2: One-Time Backward-Compatible Normalization for Pre-Upgrade Accounts
          (
            (!('totalXp' in ext) || !('totalPointsEarned' in ext) || !('currentPoints' in ext)) &&
            changed.hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned', 'updatedAt'
            ]) &&
            int(inc.points) == int(ext.points) &&
            int(inc.currentPoints) == int(ext.points) &&
            int(inc.totalPointsEarned) == existingTotalPointsEarnedRule(ext) &&
            int(inc.totalXp) == existingTotalXpRule(ext) &&
            int(inc.level) == computeLevelRule(inc.totalXp) &&
            int(inc.xp) == computeCurrentLevelXpRule(inc.totalXp)
          ) ||
          // Action 3: Server-Verified Atomic Match Reward Claim (+100 XP/+1000 Pts Win, +75 XP/+500 Pts Loss)
          (
            changed.hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned',
              'totalGames', 'totalWins', 'lastClaimId', 'updatedAt'
            ]) &&
            isValidUserMatchRewardUpdate(inc, ext, userId)
          ) ||
          // Action 4: Server-Verified Atomic Daily Login Reward Claim
          (
            changed.hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned',
              'lastDailyClaimId', 'updatedAt'
            ]) &&
            isValidUserDailyRewardUpdate(inc, ext, userId)
          ) ||
          // Action 5: Server-Verified Atomic Achievement Reward Claim
          (
            changed.hasOnly([
              'totalXp', 'level', 'xp', 'points', 'currentPoints', 'totalPointsEarned',
              'claimedAchievements', 'lastAchievementClaimId', 'updatedAt'
            ]) &&
            isValidUserAchievementRewardUpdate(inc, ext, userId)
          ) ||
          // Action 6: Shop Item Purchase (Deducts ONLY Current Points; Total Points Earned & XP/Level Unchanged!)
          (
            changed.hasOnly([
              'points', 'currentPoints', 'totalPointsEarned',
              'totalXp', 'level', 'xp', 'inventory', 'updatedAt'
            ]) &&
            inc.inventory.size() == ext.inventory.size() + 1 &&
            int(inc.points) <= existingCurrentPointsRule(ext) &&
            int(inc.points) >= 0 &&
            int(inc.currentPoints) == int(inc.points) &&
            int(inc.totalPointsEarned) == existingTotalPointsEarnedRule(ext) &&
            int(inc.totalXp) == existingTotalXpRule(ext) &&
            int(inc.level) == computeLevelRule(inc.totalXp) &&
            int(inc.xp) == computeCurrentLevelXpRule(inc.totalXp)
          )
        );
    }

    // Room Player & Roster Validation Helpers (Bounded 1..4 Players, Zero Loops, CEL let-bound)
    function isAllowedRoomGameType(gameType) {
      return gameType is string && gameType in ['snakes_and_ladders', 'snow_rush'];
    }

    function isValidRoomPlayer(p) {
      let pk = p.keys();
      let uid = p.uid;
      let name = p.displayName;
      let pos = p.position;
      let lmid = p.get('lastMoveId', null);
      let dAt = p.get('disconnectedAt', null);
      let rk = p.get('rank', 1);
      return p is map &&
        pk.hasAll(['uid', 'displayName', 'isReady', 'position']) &&
        pk.hasOnly([
          'uid', 'playerId', 'displayName', 'photoURL', 'isReady', 'color',
          'position', 'positionVersion', 'lastMoveId', 'updatedAtMs',
          'activeTokenSkin', 'isConnected', 'lastSeen', 'rank', 'disconnectedAt'
        ]) &&
        uid is string && uid.size() >= 1 && uid.size() <= 128 &&
        (p.get('playerId', '') + '').size() <= 32 &&
        name is string && name.size() >= 1 && name.size() <= 60 &&
        (p.get('photoURL', '') + '').size() <= 1000 &&
        p.isReady is bool &&
        (p.get('color', '') + '').size() <= 24 &&
        pos is number && pos >= 1 && pos <= 100 &&
        p.get('positionVersion', 1) >= 1 &&
        (lmid == null || (lmid is string && lmid.size() <= 80)) &&
        p.get('updatedAtMs', 0) >= 0 &&
        (p.get('activeTokenSkin', '') + '').size() <= 50 &&
        p.get('isConnected', true) is bool &&
        p.get('lastSeen', 0) >= 0 &&
        rk >= 1 && rk <= 4 &&
        (dAt == null || (dAt is number && dAt >= 0));
    }

    function areAllRoomPlayersValid(players) {
      let sz = players.size();
      return players is list && sz >= 1 && sz <= 4 &&
        isValidRoomPlayer(players[0]) &&
        (sz < 2 || isValidRoomPlayer(players[1])) &&
        (sz < 3 || isValidRoomPlayer(players[2])) &&
        (sz < 4 || isValidRoomPlayer(players[3]));
    }

    function isValidExistingPlayerDelta(oldP, p, pAllowed) {
      let lmid = p.get('lastMoveId', null);
      let dAt = p.get('disconnectedAt', null);
      let rk = p.get('rank', 1);
      return p is map &&
        p.uid == oldP.uid &&
        p.diff(oldP).affectedKeys().hasOnly(pAllowed) &&
        p.isReady is bool &&
        p.position >= 1 && p.position <= 100 &&
        p.get('positionVersion', 1) >= 1 &&
        (lmid == null || (lmid is string && lmid.size() <= 80)) &&
        p.get('updatedAtMs', 0) >= 0 &&
        p.get('isConnected', true) is bool &&
        p.get('lastSeen', 0) >= 0 &&
        rk >= 1 && rk <= 4 &&
        (dAt == null || dAt >= 0);
    }

    function isValidUpdatedPlayerSlot(oldPlayers, oldSz, p, idx, pAllowed) {
      return (p in oldPlayers) ||
        (oldSz > idx && oldPlayers[idx].uid == p.uid && isValidExistingPlayerDelta(oldPlayers[idx], p, pAllowed)) ||
        isValidRoomPlayer(p);
    }

    function areUpdatedRoomPlayersValid(oldPlayers, newPlayers) {
      let newSz = newPlayers.size();
      let oldSz = oldPlayers.size();
      let pAllowed = [
        'isReady', 'position', 'positionVersion', 'lastMoveId',
        'updatedAtMs', 'isConnected', 'lastSeen', 'rank', 'disconnectedAt'
      ];
      return newPlayers is list && newSz >= 1 && newSz <= 4 && (
        newPlayers == oldPlayers || (
          isValidUpdatedPlayerSlot(oldPlayers, oldSz, newPlayers[0], 0, pAllowed) &&
          (newSz < 2 || isValidUpdatedPlayerSlot(oldPlayers, oldSz, newPlayers[1], 1, pAllowed)) &&
          (newSz < 3 || isValidUpdatedPlayerSlot(oldPlayers, oldSz, newPlayers[2], 2, pAllowed)) &&
          (newSz < 4 || isValidUpdatedPlayerSlot(oldPlayers, oldSz, newPlayers[3], 3, pAllowed))
        )
      );
    }

    function hasUniquePlayerUids(players) {
      let sz = players.size();
      return (sz < 2 || players[0].uid != players[1].uid) &&
        (sz < 3 || (players[0].uid != players[2].uid && players[1].uid != players[2].uid)) &&
        (sz < 4 || (players[0].uid != players[3].uid && players[1].uid != players[3].uid && players[2].uid != players[3].uid));
    }

    function isPlayerInList(players, uid) {
      let sz = players.size();
      return players is list && (
        (sz >= 1 && players[0].uid == uid) ||
        (sz >= 2 && players[1].uid == uid) ||
        (sz >= 3 && players[2].uid == uid) ||
        (sz >= 4 && players[3].uid == uid)
      );
    }

    function samePlayerRosterUids(oldPlayers, newPlayers) {
      let sz = oldPlayers.size();
      return sz == newPlayers.size() &&
        (sz < 1 || oldPlayers[0].uid == newPlayers[0].uid) &&
        (sz < 2 || oldPlayers[1].uid == newPlayers[1].uid) &&
        (sz < 3 || oldPlayers[2].uid == newPlayers[2].uid) &&
        (sz < 4 || oldPlayers[3].uid == newPlayers[3].uid);
    }

    function samePlayerPositions(oldPlayers, newPlayers) {
      let sz = oldPlayers.size();
      return sz == newPlayers.size() &&
        (sz < 1 || oldPlayers[0].position == newPlayers[0].position) &&
        (sz < 2 || oldPlayers[1].position == newPlayers[1].position) &&
        (sz < 3 || oldPlayers[2].position == newPlayers[2].position) &&
        (sz < 4 || oldPlayers[3].position == newPlayers[3].position);
    }

    function samePlayersReady(oldPlayers, newPlayers) {
      let sz = oldPlayers.size();
      return sz == newPlayers.size() &&
        (sz < 1 || oldPlayers[0].isReady == newPlayers[0].isReady) &&
        (sz < 2 || oldPlayers[1].isReady == newPlayers[1].isReady) &&
        (sz < 3 || oldPlayers[2].isReady == newPlayers[2].isReady) &&
        (sz < 4 || oldPlayers[3].isReady == newPlayers[3].isReady);
    }

    function isValidReadySlot(oldP, newP, callerUid) {
      return oldP.uid == newP.uid &&
        oldP.position == newP.position &&
        (oldP.uid == callerUid || oldP.isReady == newP.isReady);
    }

    function isValidReadyToggleRoster(oldPlayers, newPlayers, callerUid) {
      let sz = oldPlayers.size();
      return sz == newPlayers.size() &&
        (sz < 1 || isValidReadySlot(oldPlayers[0], newPlayers[0], callerUid)) &&
        (sz < 2 || isValidReadySlot(oldPlayers[1], newPlayers[1], callerUid)) &&
        (sz < 3 || isValidReadySlot(oldPlayers[2], newPlayers[2], callerUid)) &&
        (sz < 4 || isValidReadySlot(oldPlayers[3], newPlayers[3], callerUid));
    }

    function areAllNonHostPlayersReady(players, hostId) {
      let sz = players.size();
      return (sz < 1 || players[0].uid == hostId || players[0].isReady == true) &&
        (sz < 2 || players[1].uid == hostId || players[1].isReady == true) &&
        (sz < 3 || players[2].uid == hostId || players[2].isReady == true) &&
        (sz < 4 || players[3].uid == hostId || players[3].isReady == true);
    }

    function sameRosterAllAtStart(oldPlayers, newPlayers) {
      let sz = oldPlayers.size();
      return sz == newPlayers.size() &&
        (sz < 1 || (oldPlayers[0].uid == newPlayers[0].uid && newPlayers[0].position == 1)) &&
        (sz < 2 || (oldPlayers[1].uid == newPlayers[1].uid && newPlayers[1].position == 1)) &&
        (sz < 3 || (oldPlayers[2].uid == newPlayers[2].uid && newPlayers[2].position == 1)) &&
        (sz < 4 || (oldPlayers[3].uid == newPlayers[3].uid && newPlayers[3].position == 1));
    }

    function preserveExistingPlayersOnJoin(oldPlayers, newPlayers, joinUid) {
      let oldSz = oldPlayers.size();
      let newSz = newPlayers.size();
      let joined = newPlayers[newSz - 1];
      return newSz == oldSz + 1 &&
        (oldSz < 1 || (oldPlayers[0].uid == newPlayers[0].uid && oldPlayers[0].isReady == newPlayers[0].isReady && oldPlayers[0].position == newPlayers[0].position)) &&
        (oldSz < 2 || (oldPlayers[1].uid == newPlayers[1].uid && oldPlayers[1].isReady == newPlayers[1].isReady && oldPlayers[1].position == newPlayers[1].position)) &&
        (oldSz < 3 || (oldPlayers[2].uid == newPlayers[2].uid && oldPlayers[2].isReady == newPlayers[2].isReady && oldPlayers[2].position == newPlayers[2].position)) &&
        joined.uid == joinUid &&
        joined.isReady == false &&
        joined.position == 1;
    }

    function playerMatchesPositionInExisting(p, oldPlayers) {
      let pUid = p.uid;
      let pPos = p.position;
      let sz = oldPlayers.size();
      return (sz >= 1 && oldPlayers[0].uid == pUid && oldPlayers[0].position == pPos) ||
        (sz >= 2 && oldPlayers[1].uid == pUid && oldPlayers[1].position == pPos) ||
        (sz >= 3 && oldPlayers[2].uid == pUid && oldPlayers[2].position == pPos) ||
        (sz >= 4 && oldPlayers[3].uid == pUid && oldPlayers[3].position == pPos);
    }

    function allRemainingPreservePositions(remPlayers, oldPlayers) {
      let sz = remPlayers.size();
      return (sz < 1 || playerMatchesPositionInExisting(remPlayers[0], oldPlayers)) &&
        (sz < 2 || playerMatchesPositionInExisting(remPlayers[1], oldPlayers)) &&
        (sz < 3 || playerMatchesPositionInExisting(remPlayers[2], oldPlayers));
    }

    function existingGameRound(roomData) {
      let gr = roomData.get('gameRound', 1);
      return gr is number ? int(gr) : 1;
    }

    function hasMonotonicStateVersion(oldRoom, newRoom) {
      let nv = newRoom.stateVersion;
      let ov = oldRoom.get('stateVersion', 0);
      return ('stateVersion' in newRoom) && nv is number && nv > ov;
    }

    function sameWinnerId(oldRoom, newRoom) {
      return oldRoom.get('winnerId', null) == newRoom.get('winnerId', null);
    }

    function isCurrentTurnPlayer(roomData, uid) {
      let idx = roomData.currentTurnIndex;
      return ('currentTurnIndex' in roomData) &&
        idx is number &&
        idx >= 0 &&
        idx < roomData.players.size() &&
        roomData.players[int(idx)].uid == uid;
    }

    function nonTurnPlayerPositionsUnchanged(oldPlayers, newPlayers, turnIdx) {
      let sz = oldPlayers.size();
      return sz == newPlayers.size() &&
        (sz < 1 || turnIdx == 0 || oldPlayers[0].position == newPlayers[0].position) &&
        (sz < 2 || turnIdx == 1 || oldPlayers[1].position == newPlayers[1].position) &&
        (sz < 3 || turnIdx == 2 || oldPlayers[2].position == newPlayers[2].position) &&
        (sz < 4 || turnIdx == 3 || oldPlayers[3].position == newPlayers[3].position);
    }

    // Verified Snakes & Ladders single-turn reachability (Dice 1..6 + Ladders 4->14, 9->31, 20->38, 28->84, 40->59, 51->67, 63->81, 71->91)
    function isValidSnakesTurnPositionStep(oldPos, newPos) {
      return newPos is number && newPos >= 1 && newPos <= 100 && (
        (newPos <= oldPos + 6 && (newPos != 100 || oldPos >= 94)) ||
        (newPos == 14 && oldPos >= 1 && oldPos <= 3) ||
        (newPos == 31 && oldPos >= 3 && oldPos <= 8) ||
        (newPos == 38 && oldPos >= 14 && oldPos <= 19) ||
        (newPos == 84 && oldPos >= 22 && oldPos <= 27) ||
        (newPos == 59 && oldPos >= 34 && oldPos <= 39) ||
        (newPos == 67 && oldPos >= 45 && oldPos <= 50) ||
        (newPos == 81 && oldPos >= 57 && oldPos <= 62) ||
        (newPos == 91 && oldPos >= 65 && oldPos <= 70)
      );
    }

    function isValidSnakesLeaveOutcome(oldRoom, newRoom) {
      let newSz = newRoom.players.size();
      return (
        oldRoom.status in ['waiting', 'full'] &&
        newRoom.get('winnerId', null) == null &&
        newRoom.get('winnerName', null) == null &&
        newRoom.status == (newSz >= newRoom.maxPlayers ? 'full' : 'waiting')
      ) || (
        oldRoom.status == 'playing' && (
          (newSz == 1 && newRoom.status == 'finished' && newRoom.winnerId == newRoom.players[0].uid) ||
          (newSz >= 2 && newRoom.status == 'playing' && newRoom.get('winnerId', null) == null && newRoom.get('winnerName', null) == null)
        )
      ) || (
        oldRoom.status == 'finished' &&
        newRoom.status == 'finished' &&
        sameWinnerId(oldRoom, newRoom)
      );
    }

    function isValidRoomCoreAndMeta(data, pSize) {
      let cti = data.get('currentTurnIndex', 0);
      let ldr = data.get('lastDiceRoll', 1);
      let lmid = data.get('lastMoveId', null);
      let rcd = data.get('reconnectionDeadline', null);
      let dpid = data.get('disconnectedPlayerId', null);
      let dpnm = data.get('disconnectedPlayerName', null);
      let wid = data.get('winnerId', null);
      let wnm = data.get('winnerName', null);
      let lmp = data.get('lastMovingPlayerUid', null);
      return (data.get('hostName', '') + '').size() <= 60 &&
        data.status in ['waiting', 'full', 'playing', 'finished'] &&
        data.maxPlayers is number && data.maxPlayers >= 2 && data.maxPlayers <= 4 &&
        pSize <= data.maxPlayers &&
        data.get('playerCount', pSize) == pSize &&
        cti >= 0 && cti < 4 &&
        ldr >= 1 && ldr <= 6 &&
        (!('matchParticipantIds' in data) || (
          data.matchParticipantIds is list && data.matchParticipantIds.size() <= 4 &&
          (data.matchParticipantIds.size() == 0 || (data.matchParticipantIds[0] is string && data.matchParticipantIds[0].size() <= 128))
        )) &&
        data.get('exactFinish', false) is bool &&
        data.get('stateVersion', 1) >= 1 &&
        data.get('gameRound', 1) >= 1 &&
        (lmid == null || (lmid is string && lmid.size() <= 80)) &&
        (!('playerPositions' in data) || (data.playerPositions is map && data.playerPositions.size() <= 4)) &&
        (!('presence' in data) || (data.presence is map && data.presence.size() <= 16)) &&
        data.get('turnStartTimestamp', 0) >= 0 &&
        data.get('turnDeadline', 0) >= 0 &&
        (rcd == null || (rcd is number && rcd >= 0)) &&
        (dpid == null || (dpid is string && dpid.size() <= 128)) &&
        (dpnm == null || (dpnm is string && dpnm.size() <= 60)) &&
        data.get('lastMoveTimestamp', 0) >= 0 &&
        (data.get('lastMoveSummary', '') + '').size() <= 500 &&
        (wid == null || (wid is string && wid.size() >= 1 && wid.size() <= 128)) &&
        (wnm == null || (wnm is string && wnm.size() <= 60)) &&
        (!('lastMovePath' in data) || (data.lastMovePath is list && data.lastMovePath.size() <= 20)) &&
        (lmp == null || (lmp is string && lmp.size() <= 128)) &&
        (data.get('createdAt', '') + '').size() <= 40 &&
        (data.get('updatedAt', '') + '').size() <= 40 &&
        (!('timestamp' in data) || data.timestamp is timestamp) &&
        (!('serverUpdatedAt' in data) || data.serverUpdatedAt is timestamp) &&
        // Phase 1 Snow Rush Result Lock: Client can NEVER set status == 'finished' or winnerId/winnerName on Snow Rush rooms
        (
          data.gameType != 'snow_rush' || (
            data.status in ['waiting', 'full', 'playing'] &&
            wid == null &&
            wnm == null
          )
        );
    }

    function isValidUpdatedRoomCore(d, pSize) {
      let wid = d.get('winnerId', null);
      let wnm = d.get('winnerName', null);
      let lmid = d.get('lastMoveId', null);
      let rcd = d.get('reconnectionDeadline', null);
      let dpid = d.get('disconnectedPlayerId', null);
      let dpnm = d.get('disconnectedPlayerName', null);
      let lmp = d.get('lastMovingPlayerUid', null);
      return d.status in ['waiting', 'full', 'playing', 'finished'] &&
        pSize <= d.maxPlayers &&
        d.get('playerCount', pSize) == pSize &&
        d.get('currentTurnIndex', 0) >= 0 && d.get('currentTurnIndex', 0) < 4 &&
        d.get('lastDiceRoll', 1) >= 1 && d.get('lastDiceRoll', 1) <= 6 &&
        d.get('stateVersion', 1) >= 1 &&
        d.get('gameRound', 1) >= 1 &&
        d.get('turnStartTimestamp', 0) >= 0 &&
        d.get('turnDeadline', 0) >= 0 &&
        d.get('lastMoveTimestamp', 0) >= 0 &&
        (d.get('hostName', '') + '').size() <= 60 &&
        (d.get('lastMoveSummary', '') + '').size() <= 500 &&
        (d.get('updatedAt', '') + '').size() <= 40 &&
        (lmid == null || (lmid is string && lmid.size() <= 80)) &&
        (rcd == null || rcd >= 0) &&
        (dpid == null || (dpid is string && dpid.size() <= 128)) &&
        (dpnm == null || (dpnm is string && dpnm.size() <= 60)) &&
        (wid == null || (wid is string && wid.size() >= 1 && wid.size() <= 128)) &&
        (wnm == null || (wnm is string && wnm.size() <= 60)) &&
        (lmp == null || (lmp is string && lmp.size() <= 128)) &&
        (!('matchParticipantIds' in d) || (d.matchParticipantIds is list && d.matchParticipantIds.size() <= 4)) &&
        (!('playerPositions' in d) || (d.playerPositions is map && d.playerPositions.size() <= 4)) &&
        (!('presence' in d) || (d.presence is map && d.presence.size() <= 16)) &&
        (!('lastMovePath' in d) || (d.lastMovePath is list && d.lastMovePath.size() <= 20)) &&
        (!('serverUpdatedAt' in d) || d.serverUpdatedAt is timestamp) &&
        (
          d.gameType != 'snow_rush' || (
            d.status in ['waiting', 'full', 'playing'] &&
            wid == null &&
            wnm == null
          )
        );
    }

    function isValidGameRoom(data) {
      let keys = data.keys();
      let players = data.players;
      let pSize = players.size();
      let roomIdVal = data.id;
      let codeVal = data.roomCode;
      let hostVal = data.hostId;
      return keys.hasAll(['id', 'roomCode', 'gameType', 'hostId', 'status', 'maxPlayers', 'players']) &&
        keys.hasOnly([
          'id', 'roomCode', 'gameType', 'hostId', 'hostName',
          'status', 'maxPlayers', 'playerCount', 'players',
          'currentTurnIndex', 'lastDiceRoll', 'lastMoveSummary',
          'winnerId', 'winnerName', 'matchParticipantIds', 'exactFinish',
          'stateVersion', 'gameRound', 'lastMoveId',
          'playerPositions', 'presence',
          'turnStartTimestamp', 'turnDeadline',
          'reconnectionDeadline', 'disconnectedPlayerId', 'disconnectedPlayerName',
          'lastMoveTimestamp', 'lastMovePath', 'lastMovingPlayerUid',
          'createdAt', 'updatedAt', 'timestamp', 'serverUpdatedAt'
        ]) &&
        roomIdVal is string && roomIdVal.size() >= 6 && roomIdVal.size() <= 64 &&
        codeVal is string && codeVal.size() >= 4 && codeVal.size() <= 16 &&
        isAllowedRoomGameType(data.gameType) &&
        hostVal is string && hostVal.size() >= 1 && hostVal.size() <= 128 &&
        areAllRoomPlayersValid(players) &&
        hasUniquePlayerUids(players) &&
        isPlayerInList(players, hostVal) &&
        isValidRoomCoreAndMeta(data, pSize);
    }

    function canCreateGameRoom(roomId) {
      let inc = request.resource.data;
      let uid = request.auth.uid;
      let players = inc.players;
      return isSignedIn() &&
        isValidId(roomId) &&
        isValidGameRoom(inc) &&
        inc.id == roomId &&
        roomId == 'room_' + inc.roomCode &&
        inc.hostId == uid &&
        inc.status == 'waiting' &&
        inc.get('winnerId', null) == null &&
        inc.get('winnerName', null) == null &&
        players.size() == 1 &&
        players[0].uid == uid &&
        players[0].position == 1 &&
        ('gameRound' in inc) && inc.gameRound == 1 &&
        ('stateVersion' in inc) && inc.stateVersion == 1 &&
        (!('timestamp' in inc) || inc.timestamp == request.time) &&
        (!('serverUpdatedAt' in inc) || inc.serverUpdatedAt == request.time);
    }

    function isValidSnakesActiveTurnMove(inc, ext, oldP, newP, uid) {
      let turnIdx = int(ext.currentTurnIndex);
      let oldPos = oldP[turnIdx].position;
      let newPos = newP[turnIdx].position;
      return ext.get('winnerId', null) == null &&
        isCurrentTurnPlayer(ext, uid) &&
        samePlayerRosterUids(oldP, newP) &&
        nonTurnPlayerPositionsUnchanged(oldP, newP, turnIdx) &&
        isValidSnakesTurnPositionStep(oldPos, newPos) &&
        inc.lastDiceRoll is number && inc.lastDiceRoll >= 1 && inc.lastDiceRoll <= 6 &&
        inc.lastMovingPlayerUid == uid &&
        inc.hostId == ext.hostId &&
        existingGameRound(inc) == existingGameRound(ext) &&
        (
          inc.status == 'playing'
            ? (inc.get('winnerId', null) == null && inc.get('winnerName', null) == null)
            : (
              inc.status == 'finished' &&
              inc.winnerId == uid &&
              oldPos >= 94 &&
              newPos == 100
            )
        ) &&
        hasMonotonicStateVersion(ext, inc);
    }

    function canUpdateGameRoom(roomId) {
      let inc = request.resource.data;
      let ext = resource.data;
      let uid = request.auth.uid;
      let oldP = ext.players;
      let newP = inc.players;
      let changed = inc.diff(ext).affectedKeys();
      let isMember = isPlayerInList(oldP, uid);
      let hostVal = inc.hostId;

      return isSignedIn() &&
        isValidId(roomId) &&
        // Universal Immutable Room Identity Fields
        inc.id == ext.id &&
        inc.roomCode == ext.roomCode &&
        isAllowedRoomGameType(inc.gameType) &&
        inc.gameType == ext.gameType &&
        inc.maxPlayers == ext.maxPlayers &&
        (!('createdAt' in ext) ? !('createdAt' in inc) : inc.createdAt == ext.createdAt) && (
          // Action 1: Member-Only Isolated Presence Heartbeat (Zero changes outside presence[uid])
          (
            changed.size() == 1 &&
            changed.hasOnly(['presence']) &&
            isMember &&
            inc.presence is map &&
            inc.presence.size() <= 16 &&
            (
              !('presence' in ext) ||
              !(ext.presence is map) ||
              inc.presence.diff(ext.presence).affectedKeys().hasOnly([uid])
            )
          ) || (
            inc.keys().hasAll(['id', 'roomCode', 'gameType', 'hostId', 'status', 'maxPlayers', 'players']) &&
            hostVal is string && hostVal.size() >= 1 && hostVal.size() <= 128 &&
            areUpdatedRoomPlayersValid(oldP, newP) &&
            isValidUpdatedRoomCore(inc, newP.size()) && (
              // Action 2: New Player Join Waiting Room (Appends Self Only)
              (
                !isMember &&
                ext.status in ['waiting', 'full'] &&
                oldP.size() >= 1 &&
                oldP.size() < ext.maxPlayers &&
                changed.hasOnly([
                  'players', 'playerCount', 'maxPlayers', 'status',
                  'winnerId', 'winnerName', 'playerPositions', 'presence',
                  'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                preserveExistingPlayersOnJoin(oldP, newP, uid) &&
                hostVal == ext.hostId &&
                existingGameRound(inc) == existingGameRound(ext) &&
                inc.get('winnerId', null) == null &&
                inc.get('winnerName', null) == null &&
                inc.status == (newP.size() >= inc.maxPlayers ? 'full' : 'waiting') &&
                hasMonotonicStateVersion(ext, inc)
              ) ||
              // Action 3: Existing Member Lobby Ready Toggle / Reconnect Sync
              (
                isMember &&
                newP.size() == oldP.size() &&
                !changed.hasAny(['gameRound', 'lastDiceRoll', 'lastMoveId', 'lastMovingPlayerUid', 'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline']) &&
                ext.status in ['waiting', 'full', 'playing'] &&
                existingGameRound(inc) == existingGameRound(ext) &&
                changed.hasOnly([
                  'players', 'playerCount', 'maxPlayers', 'status',
                  'winnerId', 'winnerName', 'playerPositions', 'presence',
                  'disconnectedPlayerId', 'disconnectedPlayerName', 'reconnectionDeadline',
                  'lastMoveSummary', 'stateVersion', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                isValidReadyToggleRoster(oldP, newP, uid) &&
                hostVal == ext.hostId &&
                sameWinnerId(ext, inc) &&
                inc.status == (ext.status == 'playing' ? 'playing' : (newP.size() >= inc.maxPlayers ? 'full' : 'waiting')) &&
                (
                  !changed.hasAny(['disconnectedPlayerId']) ||
                  (('disconnectedPlayerId' in ext) && ext.disconnectedPlayerId == uid && inc.disconnectedPlayerId == null && inc.reconnectionDeadline == null)
                ) &&
                hasMonotonicStateVersion(ext, inc)
              ) ||
              // Action 4: Host Start Game (waiting | full -> playing; requires >= 2 players & non-host ready)
              (
                ext.status in ['waiting', 'full'] &&
                inc.status == 'playing' &&
                ext.hostId == uid &&
                changed.hasOnly([
                  'status', 'players', 'playerCount', 'playerPositions',
                  'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
                  'reconnectionDeadline', 'disconnectedPlayerId', 'disconnectedPlayerName',
                  'lastMoveId', 'lastMovePath', 'lastMovingPlayerUid',
                  'winnerId', 'winnerName', 'matchParticipantIds',
                  'gameRound', 'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                hostVal == ext.hostId &&
                oldP.size() >= 2 &&
                oldP.size() <= ext.maxPlayers &&
                areAllNonHostPlayersReady(oldP, ext.hostId) &&
                sameRosterAllAtStart(oldP, newP) &&
                inc.get('winnerId', null) == null &&
                inc.get('winnerName', null) == null &&
                ('gameRound' in inc) && inc.gameRound is number &&
                int(inc.gameRound) == existingGameRound(ext) + 1 &&
                hasMonotonicStateVersion(ext, inc)
              ) ||
              // Action 5: Snakes & Ladders Active Turn Dice Roll & Verified Tile Progression
              (
                ext.gameType == 'snakes_and_ladders' &&
                ext.status == 'playing' &&
                changed.hasAny(['lastDiceRoll', 'lastMoveId', 'lastMovingPlayerUid']) &&
                changed.hasOnly([
                  'players', 'playerPositions', 'presence',
                  'lastDiceRoll', 'lastMoveSummary', 'lastMoveId', 'lastMoveTimestamp',
                  'lastMovePath', 'lastMovingPlayerUid',
                  'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
                  'stateVersion', 'status', 'winnerId', 'winnerName',
                  'matchParticipantIds', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                isValidSnakesActiveTurnMove(inc, ext, oldP, newP, uid)
              ) ||
              // Action 6: Snakes & Ladders Disconnect / Reconnection Timeout / Turn Timeout Recovery
              (
                ext.gameType == 'snakes_and_ladders' &&
                isMember &&
                newP.size() == oldP.size() &&
                inc.status == ext.status &&
                ext.status in ['waiting', 'full', 'playing'] &&
                changed.hasOnly([
                  'players', 'playerPositions', 'presence',
                  'disconnectedPlayerId', 'disconnectedPlayerName', 'reconnectionDeadline',
                  'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
                  'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                samePlayerRosterUids(oldP, newP) &&
                samePlayerPositions(oldP, newP) &&
                samePlayersReady(oldP, newP) &&
                hostVal == ext.hostId &&
                existingGameRound(inc) == existingGameRound(ext) &&
                sameWinnerId(ext, inc) &&
                (
                  !changed.hasAny(['disconnectedPlayerId']) ||
                  inc.disconnectedPlayerId == uid ||
                  inc.disconnectedPlayerId == null
                ) &&
                hasMonotonicStateVersion(ext, inc)
              ) ||
              // Action 7: Member Leave Room (Self-Removal + Host Promotion; Snow Rush Never Sets Finished/Winner)
              (
                isMember &&
                newP.size() == oldP.size() - 1 &&
                oldP.size() >= 2 &&
                changed.hasOnly([
                  'players', 'playerCount', 'status', 'playerPositions',
                  'hostId', 'hostName',
                  'currentTurnIndex', 'turnStartTimestamp', 'turnDeadline',
                  'winnerId', 'winnerName', 'matchParticipantIds',
                  'disconnectedPlayerId', 'disconnectedPlayerName', 'reconnectionDeadline',
                  'stateVersion', 'lastMoveSummary', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                !isPlayerInList(newP, uid) &&
                hasUniquePlayerUids(newP) &&
                isPlayerInList(newP, hostVal) &&
                allRemainingPreservePositions(newP, oldP) &&
                (
                  ext.hostId == uid
                    ? hostVal == newP[0].uid
                    : hostVal == ext.hostId
                ) &&
                existingGameRound(inc) == existingGameRound(ext) &&
                (
                  ext.gameType == 'snow_rush'
                    ? (
                      inc.get('winnerId', null) == null &&
                      inc.get('winnerName', null) == null &&
                      inc.status == (
                        ext.status == 'playing'
                          ? (newP.size() >= 2 ? 'playing' : 'waiting')
                          : (newP.size() >= inc.maxPlayers ? 'full' : 'waiting')
                      )
                    )
                    : isValidSnakesLeaveOutcome(ext, inc)
                ) &&
                hasMonotonicStateVersion(ext, inc)
              ) ||
              // Action 8: Snakes & Ladders Host Play Again Reset (finished -> waiting | full, gameRound + 1)
              (
                ext.gameType == 'snakes_and_ladders' &&
                ext.status == 'finished' &&
                ext.hostId == uid &&
                changed.hasOnly([
                  'players', 'playerCount', 'playerPositions', 'status',
                  'currentTurnIndex', 'lastDiceRoll', 'gameRound', 'stateVersion',
                  'lastMoveId', 'lastMovePath', 'lastMovingPlayerUid',
                  'turnStartTimestamp', 'turnDeadline',
                  'reconnectionDeadline', 'disconnectedPlayerId', 'disconnectedPlayerName',
                  'lastMoveSummary', 'winnerId', 'winnerName', 'matchParticipantIds',
                  'lastMoveTimestamp', 'updatedAt', 'serverUpdatedAt'
                ]) &&
                hostVal == ext.hostId &&
                sameRosterAllAtStart(oldP, newP) &&
                inc.status == (newP.size() >= inc.maxPlayers ? 'full' : 'waiting') &&
                inc.get('winnerId', null) == null &&
                inc.get('winnerName', null) == null &&
                ('gameRound' in inc) && inc.gameRound is number &&
                int(inc.gameRound) == existingGameRound(ext) + 1 &&
                hasMonotonicStateVersion(ext, inc)
              )
            )
          )
        );
    }

    function isValidMatchRewardClaim(rawData) {
      let data = rawData;
      return data.keys().hasAll(['id', 'userId', 'roomId', 'gameRound', 'outcome', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'roomId', 'gameRound', 'outcome', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.roomId is string && data.roomId.size() <= 64 && isValidId(data.roomId) &&
        data.gameRound is number && data.gameRound >= 1 &&
        data.outcome in ['win', 'loss'] &&
        data.xpGranted is number && (data.xpGranted == 100 || data.xpGranted == 75) &&
        data.pointsGranted is number && (data.pointsGranted == 1000 || data.pointsGranted == 500) &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.serverCreatedAt == request.time;
    }

    function isValidDailyClaim(rawData) {
      let data = rawData;
      return data.keys().hasAll(['id', 'userId', 'dayBucket', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'dayBucket', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.dayBucket is number && data.dayBucket >= 19000 &&
        data.xpGranted == 80 &&
        data.pointsGranted == 100 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.serverCreatedAt == request.time;
    }

    function isValidAchievementClaim(rawData) {
      let data = rawData;
      return data.keys().hasAll(['id', 'userId', 'achievementId', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'achievementId', 'xpGranted', 'pointsGranted', 'createdAt', 'serverCreatedAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.achievementId is string && data.achievementId in ['first_win', 'win_5', 'games_10', 'reach_lvl_5'] &&
        data.xpGranted is number && data.xpGranted > 0 &&
        data.pointsGranted is number && data.pointsGranted > 0 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.serverCreatedAt == request.time;
    }

    function isValidTransaction(rawData) {
      let data = rawData;
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'description', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'type', 'amount', 'xpAmount', 'description', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
        data.type is string && data.type.size() <= 40 &&
        data.amount is number &&
        (!('xpAmount' in data) || (data.xpAmount is number && data.xpAmount >= 0)) &&
        data.description is string && data.description.size() <= 240 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Verified Match Outcome Relational Helper (Phase 1: Restricted strictly to snakes_and_ladders)
    function isServerVerifiedMatchReward(rawClaim) {
      let claim = rawClaim;
      let room = get(/databases/$(database)/documents/rooms/$(claim.roomId)).data;
      let roomRound = ('gameRound' in room && room.gameRound is number) ? int(room.gameRound) : 1;
      let isParticipant =
        room.winnerId == request.auth.uid ||
        ('matchParticipantIds' in room && room.matchParticipantIds is list && request.auth.uid in room.matchParticipantIds) ||
        ('playerPositions' in room && room.playerPositions is map && request.auth.uid in room.playerPositions);

      return room.gameType == 'snakes_and_ladders' &&
        room.status == 'finished' &&
        room.winnerId is string && room.winnerId.size() > 0 &&
        roomRound == claim.gameRound &&
        isParticipant &&
        (
          (room.winnerId == request.auth.uid && claim.outcome == 'win' && claim.xpGranted == 100 && claim.pointsGranted == 1000) ||
          (room.winnerId != request.auth.uid && claim.outcome == 'loss' && claim.xpGranted == 75 && claim.pointsGranted == 500)
        );
    }

    // Verified Achievement Eligibility Helper
    function isServerVerifiedAchievementReward(rawClaim) {
      let claim = rawClaim;
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (claim.achievementId == 'first_win' && user.totalWins >= 1 && claim.xpGranted == 150 && claim.pointsGranted == 100) ||
        (claim.achievementId == 'win_5' && user.totalWins >= 5 && claim.xpGranted == 400 && claim.pointsGranted == 300) ||
        (claim.achievementId == 'games_10' && user.totalGames >= 10 && claim.xpGranted == 300 && claim.pointsGranted == 200) ||
        (claim.achievementId == 'reach_lvl_5' && user.level >= 5 && claim.xpGranted == 500 && claim.pointsGranted == 500);
    }

    // 1. Users Collection (Anti-Tamper Action-Based Progression & Separated Point Balances)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if canCreateUser(userId);
      allow update: if canUpdateUser(userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // 2. Game Rooms Collection (Action-Based Member/Host/Turn Security + Snow Rush Phase 1 Lock)
    match /rooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId);
      allow list: if isSignedIn() && resource.data.status in ['waiting', 'full', 'playing', 'finished'];
      allow create: if canCreateGameRoom(roomId);
      allow update: if canUpdateGameRoom(roomId);

      allow delete: if isSignedIn() &&
        isValidId(roomId) &&
        isPlayerInList(existing().players, request.auth.uid) &&
        (
          existing().players.size() == 1 ||
          (existing().hostId == request.auth.uid && existing().status != 'playing')
        );
    }

    // 3. Immutable Match Reward Claims (Idempotency + Server Outcome Verification)
    match /reward_claims/{claimId} {
      allow get: if isSignedIn() && isValidId(claimId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(claimId) &&
        isValidMatchRewardClaim(incoming()) &&
        incoming().id == claimId &&
        claimId == incoming().roomId + '_r' + string(incoming().gameRound) + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/rooms/$(incoming().roomId)) &&
        isServerVerifiedMatchReward(incoming());
      allow update, delete: if false;
    }

    // 4. Immutable Daily Login Reward Claims
    match /daily_claims/{dailyClaimId} {
      allow get: if isSignedIn() && isValidId(dailyClaimId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(dailyClaimId) &&
        isValidDailyClaim(incoming()) &&
        incoming().id == dailyClaimId &&
        dailyClaimId == request.auth.uid + '_d' + string(incoming().dayBucket) &&
        incoming().dayBucket >= (request.time.toMillis() / 86400000) - 1 &&
        incoming().dayBucket <= (request.time.toMillis() / 86400000) + 1;
      allow update, delete: if false;
    }

    // 5. Immutable Achievement Reward Claims
    match /achievement_claims/{achClaimId} {
      allow get: if isSignedIn() && isValidId(achClaimId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidId(achClaimId) &&
        isValidAchievementClaim(incoming()) &&
        incoming().id == achClaimId &&
        achClaimId == request.auth.uid + '_ach_' + incoming().achievementId &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isServerVerifiedAchievementReward(incoming());
      allow update, delete: if false;
    }

    // 6. Point & XP Transactions Ledger
    match /transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(txId) &&
        isValidTransaction(incoming());
      allow update, delete: if false;
    }
  }
}
