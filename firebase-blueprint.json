{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with Level 1-999 progression, Total XP, separated Current Point Balance vs Total Points Earned, and customization inventory",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "playerId": {
          "type": "string",
          "description": "Unique player ID e.g. SG-729481",
          "maxLength": 24
        },
        "displayName": {
          "type": "string",
          "description": "Display name of player",
          "maxLength": 60
        },
        "email": {
          "type": "string",
          "description": "Account email",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL",
          "maxLength": 1000
        },
        "level": {
          "type": "number",
          "description": "Current player level (1 to 999)"
        },
        "xp": {
          "type": "number",
          "description": "Current in-level experience progress"
        },
        "totalXp": {
          "type": "number",
          "description": "Cumulative lifetime experience points (continues accumulating past Level 999)"
        },
        "points": {
          "type": "number",
          "description": "Current spendable gold points balance (synced with currentPoints)"
        },
        "currentPoints": {
          "type": "number",
          "description": "Current spendable point balance (reduced only by Shop purchases)"
        },
        "totalPointsEarned": {
          "type": "number",
          "description": "Cumulative lifetime points earned (never reduced by Shop purchases; used for Point Leaderboard)"
        },
        "totalWins": {
          "type": "number",
          "description": "Total mini games won"
        },
        "totalGames": {
          "type": "number",
          "description": "Total mini games played"
        },
        "activeFrame": {
          "type": "string",
          "description": "Currently equipped avatar frame item id",
          "maxLength": 50
        },
        "activeBoardSkin": {
          "type": "string",
          "description": "Currently equipped board theme id",
          "maxLength": 50
        },
        "activeDiceSkin": {
          "type": "string",
          "description": "Currently equipped dice skin id",
          "maxLength": 50
        },
        "activeTokenSkin": {
          "type": "string",
          "description": "Currently equipped token style id",
          "maxLength": 50
        },
        "inventory": {
          "type": "array",
          "description": "List of purchased item IDs"
        },
        "claimedAchievements": {
          "type": "array",
          "description": "List of claimed achievement IDs"
        },
        "lastClaimId": {
          "type": "string",
          "description": "Last verified atomic match reward claim receipt ID",
          "maxLength": 128
        },
        "lastDailyClaimId": {
          "type": "string",
          "description": "Last verified atomic daily reward claim receipt ID",
          "maxLength": 128
        },
        "lastAchievementClaimId": {
          "type": "string",
          "description": "Last verified atomic achievement claim receipt ID",
          "maxLength": 128
        },
        "activeRoomId": {
          "type": "string",
          "description": "Currently active multiplayer room ID for session persistence",
          "maxLength": 64
        },
        "activeRoomCode": {
          "type": "string",
          "description": "Short 6-character code of currently active room",
          "maxLength": 16
        },
        "activeGameType": {
          "type": "string",
          "description": "Game type identifier of active room session",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 40
        }
      },
      "required": ["id", "playerId", "displayName", "level", "points"]
    },
    "GameRoom": {
      "title": "GameRoom",
      "description": "Real-time multiplayer game room and state",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Room ID",
          "maxLength": 64
        },
        "roomCode": {
          "type": "string",
          "description": "Short 6 character room code",
          "maxLength": 16
        },
        "gameType": {
          "type": "string",
          "description": "Identifier of the mini game",
          "maxLength": 40
        },
        "hostId": {
          "type": "string",
          "description": "User ID of the room creator",
          "maxLength": 128
        },
        "hostName": {
          "type": "string",
          "description": "Display name of host",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "description": "Room status: waiting, full, playing, finished",
          "enum": ["waiting", "full", "playing", "finished"]
        },
        "maxPlayers": {
          "type": "number",
          "description": "Maximum players allowed"
        },
        "playerCount": {
          "type": "number",
          "description": "Authoritative count of unique active players in the room"
        },
        "players": {
          "type": "array",
          "description": "Array of connected player objects"
        },
        "matchParticipantIds": {
          "type": "array",
          "description": "Bounded list of player UIDs participating in the completed match"
        },
        "currentTurnIndex": {
          "type": "number",
          "description": "Index of player whose turn it is"
        },
        "lastDiceRoll": {
          "type": "number",
          "description": "Result of last dice roll 1-6"
        },
        "lastMoveSummary": {
          "type": "string",
          "description": "Burmese description of the last move event",
          "maxLength": 500
        },
        "winnerId": {
          "type": "string",
          "description": "UID of the winner if game finished",
          "maxLength": 128
        },
        "winnerName": {
          "type": "string",
          "description": "Name of the winner",
          "maxLength": 60
        },
        "exactFinish": {
          "type": "boolean",
          "description": "Rule requirement: exact roll required to reach 100"
        },
        "turnStartTimestamp": {
          "type": "number",
          "description": "Timestamp ms when turn began"
        },
        "turnDeadline": {
          "type": "number",
          "description": "Timestamp ms when 30s countdown expires"
        },
        "reconnectionDeadline": {
          "type": "number",
          "description": "Timestamp ms when 60s reconnection grace period expires"
        },
        "disconnectedPlayerId": {
          "type": "string",
          "description": "UID of disconnected player if any",
          "maxLength": 128
        },
        "disconnectedPlayerName": {
          "type": "string",
          "description": "Name of disconnected player",
          "maxLength": 60
        },
        "lastMoveTimestamp": {
          "type": "number",
          "description": "Timestamp ms of last move"
        },
        "lastMovePath": {
          "type": "array",
          "description": "Tile path array for animated movement"
        },
        "lastMovingPlayerUid": {
          "type": "string",
          "description": "UID of player who made the last move",
          "maxLength": 128
        },
        "stateVersion": {
          "type": "number",
          "description": "Monotonic room state version counter"
        },
        "gameRound": {
          "type": "number",
          "description": "Monotonic match round counter incremented on reset"
        },
        "lastMoveId": {
          "type": "string",
          "description": "Unique identifier for the latest dice move",
          "maxLength": 80
        },
        "playerPositions": {
          "type": "object",
          "description": "Per-player authoritative position and positionVersion map"
        },
        "presence": {
          "type": "object",
          "description": "Isolated per-player connection presence and heartbeat timestamps"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of room creation",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of room update",
          "maxLength": 40
        },
        "serverUpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Authoritative Firestore serverTimestamp"
        }
      },
      "required": ["id", "roomCode", "gameType", "hostId", "status", "maxPlayers", "players"]
    },
    "MatchRewardClaim": {
      "title": "MatchRewardClaim",
      "description": "Immutable idempotent receipt proving a player claimed their verified match reward once",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic claim ID: {roomId}_r{gameRound}_{uid}",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "description": "Player UID claiming the reward",
          "maxLength": 128
        },
        "roomId": {
          "type": "string",
          "description": "Finished GameRoom ID",
          "maxLength": 64
        },
        "gameRound": {
          "type": "number",
          "description": "Finished GameRoom round counter"
        },
        "outcome": {
          "type": "string",
          "description": "Verified match result for this player",
          "enum": ["win", "loss"]
        },
        "xpGranted": {
          "type": "number",
          "description": "Verified XP granted (+100 win, +75 loss)"
        },
        "pointsGranted": {
          "type": "number",
          "description": "Verified Points granted (+1000 win, +500 loss)"
        },
        "createdAt": {
          "type": "string",
          "description": "Client ISO timestamp",
          "maxLength": 40
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Authoritative Firestore serverTimestamp"
        }
      },
      "required": ["id", "userId", "roomId", "gameRound", "outcome", "xpGranted", "pointsGranted", "createdAt", "serverCreatedAt"]
    },
    "DailyRewardClaim": {
      "title": "DailyRewardClaim",
      "description": "Immutable idempotent receipt for once-per-day login reward",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic daily claim ID: {uid}_d{dayBucket}",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Player UID",
          "maxLength": 128
        },
        "dayBucket": {
          "type": "number",
          "description": "UTC epoch day bucket"
        },
        "xpGranted": {
          "type": "number",
          "description": "Verified daily XP granted"
        },
        "pointsGranted": {
          "type": "number",
          "description": "Verified daily Points granted"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 40
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Authoritative server timestamp"
        }
      },
      "required": ["id", "userId", "dayBucket", "xpGranted", "pointsGranted", "createdAt", "serverCreatedAt"]
    },
    "AchievementRewardClaim": {
      "title": "AchievementRewardClaim",
      "description": "Immutable idempotent receipt for one-time achievement reward",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Deterministic achievement claim ID: {uid}_ach_{achievementId}",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Player UID",
          "maxLength": 128
        },
        "achievementId": {
          "type": "string",
          "description": "Achievement identifier",
          "maxLength": 40
        },
        "xpGranted": {
          "type": "number",
          "description": "Verified achievement XP granted"
        },
        "pointsGranted": {
          "type": "number",
          "description": "Verified achievement Points granted"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 40
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Authoritative server timestamp"
        }
      },
      "required": ["id", "userId", "achievementId", "xpGranted", "pointsGranted", "createdAt", "serverCreatedAt"]
    },
    "PointTransaction": {
      "title": "PointTransaction",
      "description": "Record of points and XP earned or spent",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Transaction identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID who owns the transaction",
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "description": "Transaction type",
          "maxLength": 40
        },
        "amount": {
          "type": "number",
          "description": "Positive for credit, negative for debit"
        },
        "xpAmount": {
          "type": "number",
          "description": "Optional XP granted in this transaction"
        },
        "description": {
          "type": "string",
          "description": "Burmese transaction description",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp",
          "maxLength": 40
        }
      },
      "required": ["id", "userId", "type", "amount", "description", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "User"
      },
      "description": "User profiles, Level 1-999 progression, Current Point Balance, and Total Points Earned"
    },
    "/rooms/{roomId}": {
      "schema": {
        "$ref": "GameRoom"
      },
      "description": "Live multiplayer game rooms and boards"
    },
    "/reward_claims/{claimId}": {
      "schema": {
        "$ref": "MatchRewardClaim"
      },
      "description": "Immutable receipts enforcing one-time server-verified match rewards"
    },
    "/daily_claims/{dailyClaimId}": {
      "schema": {
        "$ref": "DailyRewardClaim"
      },
      "description": "Immutable receipts enforcing once-per-day login rewards"
    },
    "/achievement_claims/{achClaimId}": {
      "schema": {
        "$ref": "AchievementRewardClaim"
      },
      "description": "Immutable receipts enforcing one-time achievement rewards"
    },
    "/transactions/{transactionId}": {
      "schema": {
        "$ref": "PointTransaction"
      },
      "description": "Ledger of point/XP rewards and shop purchases"
    }
  }
}
